#!/usr/bin/env bash
# Makes the right Command key Herdr's one-key prefix.
#
# A terminal can only transmit what a terminal can encode, and a bare modifier is
# not that. So the key is renamed one layer lower: macOS remaps the right Command
# usage to F12 in the HID stack, every application from then on sees a real F12,
# and WezTerm sends the ordinary "\e[24~" that survives any ssh hop unchanged.
# Herdr's prefix is F12, so the same keystroke works locally and on a remote
# server without either side knowing about the remap.
#
# The mapping is session state, not a file, so login has to reassert it; the
# home.nix launchd agent runs this script at load for that reason.
set -euo pipefail

HIDUTIL_BIN="${HIDUTIL_BIN:-/usr/bin/hidutil}"
JQ_BIN="${JQ_BIN:-$(command -v jq 2>/dev/null || true)}"
AWK_BIN="${AWK_BIN:-/usr/bin/awk}"
GREP_BIN="${GREP_BIN:-/usr/bin/grep}"
UNAME_BIN="${UNAME_BIN:-/usr/bin/uname}"
# HID usage page 0x07: right GUI is 0xE7, F12 is 0x45.
RIGHT_COMMAND_USAGE=30064771303
F12_USAGE=30064771141

die() {
	printf 'herdr-prefix: %s\n' "$1" >&2
	exit 1
}

[ "$("$UNAME_BIN" -s)" = Darwin ] || die 'this key mapping supports macOS only'
[ -x "$HIDUTIL_BIN" ] || die 'hidutil is unavailable'
[ -n "$JQ_BIN" ] || die 'jq is unavailable after the Nix activation'
[ -x "$AWK_BIN" ] || die 'awk is unavailable'
[ -x "$GREP_BIN" ] || die 'grep is unavailable'

current_mapping="$("$HIDUTIL_BIN" property --get UserKeyMapping 2>/dev/null || true)"
# Every mapping this script does not own is carried over verbatim; only a right
# Command source is dropped, so a rerun replaces its own pair instead of stacking
# a duplicate onto it.
# Dollar-prefixed names in this program are awk fields.
# shellcheck disable=SC2016
preserved_pairs="$(printf '%s\n' "$current_mapping" | "$AWK_BIN" -v owned="$RIGHT_COMMAND_USAGE" '
	/^[[:space:]]*\{/ { src = ""; dst = "" }
	/HIDKeyboardModifierMappingSrc[[:space:]]*=/ {
		src = $3
		gsub(/;/, "", src)
	}
	/HIDKeyboardModifierMappingDst[[:space:]]*=/ {
		dst = $3
		gsub(/;/, "", dst)
	}
	/^[[:space:]]*\}/ && src != "" && dst != "" && src != owned {
		print src "\t" dst
	}
')"

# Dollar-prefixed names in this program are jq variables.
# shellcheck disable=SC2016
mapping_payload="$(printf '%s\n' "$preserved_pairs" | "$JQ_BIN" -Rnc \
	--argjson src "$RIGHT_COMMAND_USAGE" \
	--argjson dst "$F12_USAGE" \
	'
	[
		inputs
		| select(length > 0)
		| split("\t")
		| {
			HIDKeyboardModifierMappingSrc: (.[0] | tonumber),
			HIDKeyboardModifierMappingDst: (.[1] | tonumber)
		}
	]
	+ [ { HIDKeyboardModifierMappingSrc: $src, HIDKeyboardModifierMappingDst: $dst } ]
	| {UserKeyMapping: .}
')"

"$HIDUTIL_BIN" property --set "$mapping_payload" >/dev/null
applied_mapping="$("$HIDUTIL_BIN" property --get UserKeyMapping 2>/dev/null || true)"
printf '%s\n' "$applied_mapping" |
	"$GREP_BIN" -Fq "HIDKeyboardModifierMappingSrc = $RIGHT_COMMAND_USAGE;" ||
	die 'the right Command mapping did not take effect'
printf '%s\n' "$applied_mapping" |
	"$GREP_BIN" -Fq "HIDKeyboardModifierMappingDst = $F12_USAGE;" ||
	die 'the right Command key was not mapped to F12'

printf '%s\n' 'herdr-prefix: right Command sends F12; Herdr uses F12'
