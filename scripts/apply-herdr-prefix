#!/usr/bin/env bash
set -euo pipefail

HIDUTIL_BIN="${HIDUTIL_BIN:-/usr/bin/hidutil}"
JQ_BIN="${JQ_BIN:-$(command -v jq 2>/dev/null || true)}"
CAPS_LOCK_USAGE=30064771129
F13_USAGE=30064771176

die() {
	printf 'herdr-prefix: %s\n' "$1" >&2
	exit 1
}

[ "$(uname -s)" = Darwin ] || die 'this key mapping supports macOS only'
[ -x "$HIDUTIL_BIN" ] || die 'hidutil is unavailable'
[ -n "$JQ_BIN" ] || die 'jq is unavailable after the Nix activation'

current_mapping="$("$HIDUTIL_BIN" property --get UserKeyMapping 2>/dev/null || true)"
preserved_pairs="$(printf '%s\n' "$current_mapping" | awk -v caps="$CAPS_LOCK_USAGE" '
	/^[[:space:]]*\{/ { src = ""; dst = "" }
	/HIDKeyboardModifierMappingSrc[[:space:]]*=/ {
		src = $3
		gsub(/;/, "", src)
	}
	/HIDKeyboardModifierMappingDst[[:space:]]*=/ {
		dst = $3
		gsub(/;/, "", dst)
	}
	/^[[:space:]]*\}/ && src != "" && dst != "" && src != caps {
		print src "\t" dst
	}
')"

# Dollar-prefixed names in this program are jq variables.
# shellcheck disable=SC2016
mapping_payload="$(printf '%s\n' "$preserved_pairs" | "$JQ_BIN" -Rnc \
	--argjson caps "$CAPS_LOCK_USAGE" \
	--argjson f13 "$F13_USAGE" '
	[
		inputs
		| select(length > 0)
		| split("\t")
		| {
			HIDKeyboardModifierMappingSrc: (.[0] | tonumber),
			HIDKeyboardModifierMappingDst: (.[1] | tonumber)
		}
	] + [{
		HIDKeyboardModifierMappingSrc: $caps,
		HIDKeyboardModifierMappingDst: $f13
	}]
	| {UserKeyMapping: .}
')"

"$HIDUTIL_BIN" property --set "$mapping_payload" >/dev/null
applied_mapping="$("$HIDUTIL_BIN" property --get UserKeyMapping 2>/dev/null || true)"
printf '%s\n' "$applied_mapping" | grep -Fq "$CAPS_LOCK_USAGE" ||
	die 'Caps Lock source mapping was not applied'
printf '%s\n' "$applied_mapping" | grep -Fq "$F13_USAGE" ||
	die 'F13 destination mapping was not applied'

printf '%s\n' 'herdr-prefix: physical Caps Lock is mapped to F13'
