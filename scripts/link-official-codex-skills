#!/usr/bin/env bash
set -euo pipefail

CODEX_DIR="${CODEX_HOME:-$HOME/.codex}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/mac-setup"
BACKUP_DIR="$STATE_DIR/skill-backups/$(date +%Y%m%d-%H%M%S)"

note() {
	printf 'codex-skills: %s\n' "$1"
}

find_skill() {
	local skill_name candidate_root candidate
	skill_name=$1
	candidate=''

	for candidate_root in \
		"$CODEX_DIR/plugins/cache" \
		"$CODEX_DIR/.tmp/bundled-marketplaces" \
		"$CODEX_DIR/browser-marketplace"; do
		[ -d "$candidate_root" ] || continue
		candidate="$(find "$candidate_root" -type f \
			-path "*/skills/$skill_name/SKILL.md" 2>/dev/null |
			sort | tail -n 1)"
		[ -n "$candidate" ] && break
	done

	[ -n "$candidate" ] || return 1
	dirname "$candidate"
}

link_skill() {
	local skill_name source root target root_label
	skill_name=$1
	source=$2

	for root in \
		"$HOME/.skills" \
		"$HOME/.agents/skills" \
		"$HOME/.claude/skills" \
		"$HOME/.codex/skills"; do
		mkdir -p "$root"
		target="$root/$skill_name"

		if [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ]; then
			continue
		fi

		if [ -e "$target" ] || [ -L "$target" ]; then
			root_label="$(printf '%s' "$root" | tr '/' '_')"
			mkdir -p "$BACKUP_DIR/$root_label"
			mv "$target" "$BACKUP_DIR/$root_label/$skill_name"
		fi
		ln -s "$source" "$target"
	done
	note "linked $skill_name for Codex and Claude"
}

retire_plugin_skill_link() {
	local skill_name root target source root_label
	skill_name=$1

	for root in \
		"$HOME/.skills" \
		"$HOME/.agents/skills" \
		"$HOME/.claude/skills" \
		"$HOME/.codex/skills"; do
		target="$root/$skill_name"
		[ -L "$target" ] || continue
		source="$(readlink "$target")"
		case "$source" in
		"$CODEX_DIR"/plugins/cache/* | "$CODEX_DIR"/.tmp/bundled-marketplaces/* | "$CODEX_DIR"/browser-marketplace/*)
			root_label="$(printf '%s' "$root" | tr '/' '_')"
			mkdir -p "$BACKUP_DIR/$root_label"
			mv "$target" "$BACKUP_DIR/$root_label/$skill_name"
			;;
		esac
	done
	note "$skill_name remains plugin-managed instead of being exposed as a global skill"
}

retire_plugin_skill_link control-in-app-browser

if source_dir="$(find_skill computer-use)"; then
	link_skill computer-use "$source_dir"
else
	note 'computer-use is not installed yet'
	note 'open Codex, enable the Computer Use plugin, then rerun this command'
fi
