#!/usr/bin/env bash
# Fleet-wide git change summary.
#
# Neogit and every other single-repository tool resolve exactly one repository
# from the current buffer or cwd. This script answers the other question: across
# every checkout, clone and linked worktree on this machine, what is changed?
#
# It is strictly read-only. GIT_OPTIONAL_LOCKS=0 keeps git from refreshing an
# index or taking a lock, so scanning a checkout that another session owns
# cannot disturb it.
#
# The default path is fully offline. PR state and validation touch the network
# or run commands, so they are opt-in and degrade to "?" rather than hanging.

set -uo pipefail

export GIT_OPTIONAL_LOCKS=0
export GIT_TERMINAL_PROMPT=0
export GH_NO_UPDATE_NOTIFIER=1

PROG=${0##*/}

# Directory names that never contain a checkout we care about but do contain
# enormous file counts. Pruning them is what keeps discovery under a second.
# GIT_FLEET_PRUNE adds machine-local names, which is where anything specific to
# one workplace belongs: this repository is public.
PRUNE_NAMES=(
	node_modules .cache Library .venv venv env .npm .Trash
	.terraform .gradle .m2 .cargo .rustup .pyenv .nvm .bundle .tox
	build dist target out coverage .next .nuxt .pytest_cache __pycache__
	.nix-defexpr .nix-profile .local .terraform.d .vscode-server .cursor-server
	# This repository's own validation scratch. Each run leaves throwaway checkouts
	# of the thing under test, which the scan would otherwise report as hundreds of
	# untracked files - the loudest rows in the table and none of them work.
	.no-mistakes .scout-validation
)
# Space-separated on purpose: each word is one more directory name to prune.
read -r -a extra_prune <<<"${GIT_FLEET_PRUNE:-}"
PRUNE_NAMES+=("${extra_prune[@]}")

DEPTH=7
SHOW_ALL=0
WANT_PR=0
WANT_VALIDATE=0
FORMAT=table
SAVE=1
ROOTS=()
NET_TIMEOUT=6

usage() {
	cat <<'EOF'
Usage: git-fleet-status [options]

Shows what changed since the previous scan, then every changed checkout in plain
words - "9 commits to push, 1 edited" - under two headings: YOUR CHECKOUTS for the
ones you edit yourself, AGENT WORKTREES for the detached worktrees agents are
given. Biggest diff first in each. Line totals cover committed work as well as
staged, unstaged and new files, so they match what git-fleet-diff renders.

Long lists stop at one screen and say how many rows they stopped short of; since
the order is biggest-first, what they hold back is always the quietest work.

Run git-fleet-diff (fleet-diff) afterwards to read any of it.

Options:
  -a, --all           hold nothing back: repositories with no changes, and every
                      row of every list rather than one screen of each
  -r, --root DIR      search root; repeatable (default: $HOME)
  -d, --depth N       maximum search depth below each root (default: 7)
      --pr            look up PR state (network; cached ~15min; "?" on failure)
      --validate      run each dirty repository's tests/check.sh ("?" without)
      --json          JSON Lines for the Neovim picker and scripts
      --paths         print only the changed repository paths
      --no-save       leave the baseline alone, so the next plain run still
                      reports everything that has happened since it was set
  -h, --help          this message

Default output is offline and read-only. Snapshots are stored below
$XDG_STATE_HOME (default: ~/.local/state); repositories are never written.

Every run saves a new baseline, which is what makes the next one able to say what
changed. That makes each scan destructive to the journal, so anything that scans
in order to show something else - git-fleet-diff, a report, a script - passes
--no-save: otherwise merely reading one diff silently consumes the answer to
"what did the agents do while I was away".

Environment:
  GIT_FLEET_EXCLUDE   colon-separated path prefixes to skip entirely, for backup
                      and migration snapshots that contain copies of checkouts
  GIT_FLEET_JOBS      scan window size (default: twice the core count)
  GIT_FLEET_STATE_DIR where the since-last-run snapshot is kept
EOF
}

while [ $# -gt 0 ]; do
	case $1 in
	-a | --all) SHOW_ALL=1 ;;
	-r | --root)
		shift
		[ $# -gt 0 ] || {
			echo "$PROG: --root needs a directory" >&2
			exit 2
		}
		ROOTS+=("$1")
		;;
	-d | --depth)
		shift
		[ $# -gt 0 ] || {
			echo "$PROG: --depth needs a number" >&2
			exit 2
		}
		DEPTH=$1
		;;
	--pr) WANT_PR=1 ;;
	--validate) WANT_VALIDATE=1 ;;
	--json) FORMAT=json ;;
	--paths) FORMAT=paths ;;
	--no-save) SAVE=0 ;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		echo "$PROG: unknown option: $1" >&2
		usage >&2
		exit 2
		;;
	esac
	shift
done

case $DEPTH in
'' | *[!0-9]*)
	echo "$PROG: --depth must be a number" >&2
	exit 2
	;;
esac

[ ${#ROOTS[@]} -gt 0 ] || ROOTS=("$HOME")

# Bound anything that touches the network. macOS has no timeout(1); perl is on
# both hosts and its alarm is enough to guarantee we never hang.
net_timeout() {
	if command -v perl >/dev/null 2>&1; then
		perl -e 'alarm shift; exec @ARGV or exit 127' "$NET_TIMEOUT" "$@"
	else
		"$@"
	fi
}

# ---------------------------------------------------------------- discovery

# Emit every candidate working-tree directory found below the roots.
#
# Roots are resolved to their physical path first: on a dev desk $HOME is often
# a symlink (/home/x -> /local/home/x) and find would not descend it otherwise.
#
# A linked worktree has .git as a file rather than a directory; stripping the
# /.git suffix gives its own working tree either way, so five worktrees of one
# repository yield five candidates. Canonicalising each one costs a git call, so
# that happens later inside the parallel scan and is deduped on the result --
# doing it here would serialise one process per candidate.
discover() {
	local root physical
	local -a expr=()
	local n
	for n in "${PRUNE_NAMES[@]}"; do
		[ ${#expr[@]} -eq 0 ] && expr=(-name "$n") || expr+=(-o -name "$n")
	done

	# fd, when the dotfiles baseline has supplied it, walks the tree on several
	# threads and is several times faster than find here. It is a pure speedup:
	# both branches return the same set, and find remains the fallback because the
	# remote dev desk has no fd.
	local -a fdexpr=()
	if command -v fd >/dev/null 2>&1; then
		for n in "${PRUNE_NAMES[@]}"; do fdexpr+=(-E "$n"); done
	fi

	for root in "${ROOTS[@]}"; do
		physical=$(cd -- "$root" 2>/dev/null && pwd -P) || continue
		if [ ${#fdexpr[@]} -gt 0 ]; then
			fd -H -u --type d --type f --type l --max-depth "$DEPTH" \
				"${fdexpr[@]}" '^\.git$' "$physical" 2>/dev/null
		else
			# -print -prune stops find descending into .git's own object store.
			find -H "$physical" -maxdepth "$DEPTH" \
				\( "${expr[@]}" \) -prune -o -name .git -print -prune 2>/dev/null
		fi
	done | sed -e 's:/*\.git/*$::' | LC_ALL=C sort -u | drop_excluded
}

# Drop candidates under any prefix in $GIT_FLEET_EXCLUDE, colon separated.
#
# Pruning by directory name cannot express this: a backup or migration snapshot
# of $HOME contains real checkouts under ordinary names, so discovery finds them
# and each one costs a full scan. Worse, they then appear as fleet rows, and
# opening Neogit on a copy of a repository is always the wrong answer. Only the
# absolute location distinguishes the copy from the original.
drop_excluded() {
	if [ -z "${GIT_FLEET_EXCLUDE:-}" ]; then
		cat
		return 0
	fi
	# Resolve every prefix the way discover() resolves its roots. Discovery emits
	# physical paths, so a prefix containing a symlink - which on macOS includes
	# anything under $TMPDIR or /tmp, and any path through a linked home - would
	# otherwise be compared against text it can never equal, and would silently
	# exclude nothing at all.
	local resolved='' entry physical
	local IFS=:
	# shellcheck disable=SC2086 # colon-splitting the list is the point
	for entry in $GIT_FLEET_EXCLUDE; do
		[ -n "$entry" ] || continue
		physical=$(cd -- "$entry" 2>/dev/null && pwd -P) || physical=$entry
		resolved=${resolved:+$resolved:}$physical
	done

	GIT_FLEET_EXCLUDE_RESOLVED=$resolved awk '
    BEGIN {
      n = split(ENVIRON["GIT_FLEET_EXCLUDE_RESOLVED"], raw, ":")
      for (i = 1; i <= n; i++) {
        sub(/\/+$/, "", raw[i])
        if (length(raw[i])) prefix[++count] = raw[i] "/"
      }
    }
    {
      for (i = 1; i <= count; i++) if (index($0 "/", prefix[i]) == 1) next
      print
    }
  '
}

# ------------------------------------------------------------- per-repo data

# Best local base to measure unique commits against, without any network call.
# One for-each-ref rather than a probe per candidate: process spawns dominate
# the runtime once the fleet is dozens of repositories deep.
base_ref() {
	git for-each-ref --format='%(refname)' \
		refs/remotes/origin/HEAD refs/remotes/origin/main refs/remotes/origin/master \
		refs/heads/main refs/heads/master 2>/dev/null |
		awk '
    { seen[$0] = 1 }
    END {
      n = split("refs/remotes/origin/HEAD refs/remotes/origin/main " \
                "refs/remotes/origin/master refs/heads/main refs/heads/master", p, " ")
      for (i = 1; i <= n; i++) if (p[i] in seen) { print p[i]; exit }
    }
  '
}

pr_state() {
	local top=$1 branch=$2 head=$3 gh cache key out
	[ -n "$branch" ] || {
		echo '?'
		return
	}
	gh=$(command -v gh-axi || command -v gh) || {
		echo '?'
		return
	}

	cache="${XDG_CACHE_HOME:-$HOME/.cache}/git-fleet-status"
	key="$cache/$(printf '%s@%s@%s' "$top" "$branch" "$head" | cksum | tr -d ' ')"
	mkdir -p "$cache" 2>/dev/null
	# 15 minute TTL: a PR's state does not change often enough to pay for a
	# round trip per repository on every scan.
	if [ -f "$key" ] && [ -z "$(find "$key" -mmin +15 2>/dev/null)" ]; then
		cat "$key"
		return
	fi

	out=$(net_timeout "$gh" pr view "$branch" --repo "$(git -C "$top" remote get-url origin 2>/dev/null)" \
		--json state,number,isDraft 2>/dev/null) || out=

	if [ -z "$out" ]; then
		echo none >"$key" 2>/dev/null
		echo none
		return
	fi

	printf '%s' "$out" | awk '
    { n = ""; s = ""; d = "" }
    match($0, /"number":[0-9]+/)  { n = substr($0, RSTART + 9, RLENGTH - 9) }
    match($0, /"state":"[A-Z]+"/) { s = substr($0, RSTART + 9, RLENGTH - 10) }
    /"isDraft":true/              { d = "draft " }
    { if (n == "") print "none"; else printf "%s#%s %s\n", d, n, tolower(s) }
  ' | head -1 | tee "$key" 2>/dev/null
}

validation() {
	local top=$1
	if [ -x "$top/tests/check.sh" ]; then
		if (cd "$top" && ./tests/check.sh >/dev/null 2>&1); then echo ok; else echo FAIL; fi
	else
		echo none
	fi
}

# Print one tab-separated record for a candidate directory, or nothing if it is
# not a working tree. The record's first field is the canonical toplevel, which
# is what the caller dedupes on.
inspect() {
	local dir=$1 slot=$2 top
	cd -- "$dir" 2>/dev/null || return 0
	# Canonical toplevel: collapses the several paths one checkout is reachable by,
	# and rejects a .git that belongs to no working tree (bare repo, stray file).
	top=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
	[ -n "$top" ] || return 0

	local branch head full_head ahead uniq base upstream
	branch=$(git symbolic-ref -q --short HEAD 2>/dev/null)
	head=$(git rev-parse -q --short HEAD 2>/dev/null)
	full_head=$(git rev-parse -q HEAD 2>/dev/null)
	if [ -z "$branch" ]; then
		branch=${head:+"($head)"}
		branch=${branch:-"(no commits)"}
	fi

	ahead='-'
	upstream=$(git rev-parse -q --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)
	if [ -n "$upstream" ]; then
		ahead=$(git rev-list --count "$upstream"..HEAD 2>/dev/null) || ahead='-'
	fi

	uniq='-'
	base=$(base_ref)
	if [ -n "$base" ] && [ -n "$head" ]; then
		uniq=$(git rev-list --count "$base"..HEAD 2>/dev/null) || uniq='-'
	fi

	# git status collapses untracked directories into one entry; ls-files names
	# every file, which is the honest count. The list is captured once because the
	# count and the line total both need it and the tree walk is the expensive part.
	local list="$WORKDIR/tmp/untracked.$slot"
	git ls-files -o --exclude-standard -z 2>/dev/null >"$list"

	# All four change sets in one subshell and one awk. Every git call here is
	# unavoidable, but process spawn is most of the cost of a fleet scan, so the
	# sections are marked inline and summed together rather than separately.
	#
	# Lines are totalled by streaming the files through cat, never by letting awk
	# open them: ls-files also names symlinks to directories, and macOS awk makes
	# getline on a directory a fatal I/O error, which would abort the whole count
	# and silently report a dirty repository as clean.
	# Whether the commits are worth measuring, decided here rather than inside the
	# process substitution below: bash 3.2 - still /bin/bash on macOS, and what
	# `#!/usr/bin/env bash` resolves to under a stripped PATH - cannot parse a case
	# statement nested inside `< <( ... )` and rejects the whole file. An empty
	# range means there is nothing new on this HEAD to count.
	local range=
	case ${uniq:-0} in
	'' | 0 | *[!0-9]*) : ;;
	*) range="$base..HEAD" ;;
	esac

	local sf sa sd uf ua ud nf na ca cd
	read -r sf sa sd uf ua ud nf na ca cd < <(
		{
			printf '\034S\n'
			if [ -n "$head" ]; then
				git diff --cached --numstat 2>/dev/null
			else
				# No commits yet: the index is measured against the empty tree.
				git diff --cached --numstat "$(git hash-object -t tree /dev/null)" 2>/dev/null
			fi
			printf '\034U\n'
			git diff --numstat 2>/dev/null
			# Lines the commits carry. Agents commit as they go, so a worktree holding
			# six finished commits and a clean tree used to report +0/-0 - the work most
			# worth reading, described as nothing. Counting the range makes the total
			# agree with what git-fleet-diff renders for the same checkout.
			#
			# Only when there is a range to measure: on the mostly-clean fleet this
			# skips the extra diff for almost every repository.
			printf '\034C\n'
			[ -n "$range" ] && git diff --numstat "$range" 2>/dev/null
			printf '\034N\n'
			tr '\0' '\n' <"$list"
			printf '\034L\n'
			xargs -0 cat <"$list" 2>/dev/null
		} | awk '
      index($0, "\034") == 1 { sec = substr($0, 2, 1); next }
      sec == "N" { if (length($0)) nf++; next }
      sec == "L" { na++; next }
      { f[sec]++; if ($1 != "-") a[sec] += $1; if ($2 != "-") d[sec] += $2 }
      END {
        printf "%d %d %d %d %d %d %d %d %d %d\n",
          f["S"] + 0, a["S"] + 0, d["S"] + 0,
          f["U"] + 0, a["U"] + 0, d["U"] + 0, nf + 0, na + 0,
          a["C"] + 0, d["C"] + 0
      }
    '
	)
	sf=${sf:-0}
	sa=${sa:-0}
	sd=${sd:-0}
	uf=${uf:-0}
	ua=${ua:-0}
	ud=${ud:-0}
	nf=${nf:-0}
	na=${na:-0}
	ca=${ca:-0}
	cd=${cd:-0}

	# A working tree counts as changed when it has uncommitted work, or commits its
	# base branch and upstream have not seen. A feature branch whose work is
	# already committed is still work in flight, and across a pool of branch
	# worktrees that is the usual state, so counting only dirty files would hide
	# most of the fleet.
	local changed=$((sf + uf + nf))
	case $uniq in '' | *[!0-9]*) : ;; *) changed=$((changed + uniq)) ;; esac
	case $ahead in '' | *[!0-9]*) : ;; *) changed=$((changed + ahead)) ;; esac
	if [ "$changed" -eq 0 ] && [ "$SHOW_ALL" -eq 0 ]; then
		rm -f "$list"
		# Still carries the toplevel so the caller can dedupe it like any other row.
		printf 'CLEAN\t%s\n' "$top"
		return 0
	fi

	# Counts alone miss an edit that replaces one line with another. Fingerprint
	# the actual staged, unstaged and untracked content so "since last run" stays
	# honest even when every displayed number is unchanged. git hash-object hashes
	# stdin without -w, so it remains read-only and adds no repository objects.
	#
	# Deliberately below the clean early return: the fingerprint costs two more
	# full binary diffs and a second read of every untracked file, and only the
	# snapshot of reported repositories ever consumes it. On a fleet that is mostly
	# clean, computing it above the return threw most of that work away.
	local fingerprint
	fingerprint=$(
		{
			printf 'HEAD\0%s\0BASE\0%s\0STAGED\0' "$full_head" "$base"
			git diff --cached --no-ext-diff --binary 2>/dev/null
			printf '\0UNSTAGED\0'
			git diff --no-ext-diff --binary 2>/dev/null
			printf '\0UNTRACKED-PATHS\0'
			cat "$list"
			printf '\0UNTRACKED-CONTENTS\0'
			xargs -0 cat <"$list" 2>/dev/null
		} | git hash-object --stdin 2>/dev/null
	)
	rm -f "$list"

	local add=$((sa + ua + na + ca)) del=$((sd + ud + cd))
	local val='?' pr='?'
	[ "$WANT_VALIDATE" -eq 1 ] && val=$(validation "$top")
	[ "$WANT_PR" -eq 1 ] && pr=$(pr_state "$top" "${upstream#*/}" "${head:-none}")
	[ -n "$val" ] || val='?'
	[ -n "$pr" ] || pr='?'

	printf 'REPO\t%s\t%s\t%s\t%s\t%d\t%d\t%d\t%d\t%d\t%s\t%s\t%s\t%s\t%s\n' \
		"$top" "$branch" "$ahead" "$uniq" "$sf" "$uf" "$nf" "$add" "$del" "$val" "$pr" \
		"$full_head" "$base" "$fingerprint"
}

# ------------------------------------------------------------------ rendering

json_escape() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# Repository paths are canonical, so on a dev desk they come back under the
# physical home (/local/home/x) while $HOME is the symlink (/home/x). Both
# prefixes have to abbreviate or those rows render full-length and ragged.
HOME_PHYS=$(cd -- "$HOME" 2>/dev/null && pwd -P) || HOME_PHYS=$HOME

# A literal "~/" prefix keeps rows short; it is display text, not a path to expand.
# shellcheck disable=SC2088
abbrev() {
	case $1 in
	"$HOME"/*) printf '~/%s\n' "${1#"$HOME"/}" ;;
	"$HOME_PHYS"/*) printf '~/%s\n' "${1#"$HOME_PHYS"/}" ;;
	*) printf '%s\n' "$1" ;;
	esac
}

# ------------------------------------------------------------------- scanning

# Repositories are independent and per-repository cost is mostly process spawn,
# so the scan runs a sliding window of them. A window rather than fixed batches
# matters because worktree sizes are wildly uneven: one huge checkout in a batch
# would otherwise hold up every small one waiting alongside it.
#
# The window defaults to well above the core count. Each slot spends most of its
# life waiting on fork/exec and small reads rather than burning a core, so sizing
# it to the core count leaves the machine idle; a flat 8 left it idle on every
# host this runs on.
cpu_count() {
	local n
	n=$(getconf _NPROCESSORS_ONLN 2>/dev/null) ||
		n=$(sysctl -n hw.logicalcpu 2>/dev/null) ||
		n=$(nproc 2>/dev/null) || n=
	case ${n:-} in '' | *[!0-9]*) printf '4\n' ;; *) printf '%s\n' "$n" ;; esac
}
JOBS=${GIT_FLEET_JOBS:-$(($(cpu_count) * 2))}
case $JOBS in '' | *[!0-9]*) JOBS=8 ;; esac
[ "$JOBS" -lt 1 ] && JOBS=1

# `wait -n` is bash 4.3+. Older bash falls back to draining the whole batch,
# which is slower but correct.
HAVE_WAIT_N=0
if [ "${BASH_VERSINFO[0]:-0}" -gt 4 ] ||
	{ [ "${BASH_VERSINFO[0]:-0}" -eq 4 ] && [ "${BASH_VERSINFO[1]:-0}" -ge 3 ]; }; then
	HAVE_WAIT_N=1
fi

WORKDIR=$(mktemp -d "${TMPDIR:-/tmp}/git-fleet-status.XXXXXX") || {
	echo "$PROG: cannot create a temporary directory" >&2
	exit 1
}
trap 'rm -rf "$WORKDIR"' EXIT INT TERM
# Records and scratch lists live in separate subdirectories so the glob that
# collects records can never pick up a scratch file left by a killed scan.
mkdir -p "$WORKDIR/rec" "$WORKDIR/tmp" || exit 1

TOTAL_REPOS=0
CLEAN_REPOS=0
RECORDS=()
CANDIDATES=0

RUNNING=0
while IFS= read -r dir; do
	[ -n "$dir" ] || continue
	CANDIDATES=$((CANDIDATES + 1))
	# Zero-padded names preserve the sorted discovery order under the glob below.
	inspect "$dir" "$CANDIDATES" >"$WORKDIR/rec/$(printf '%06d' "$CANDIDATES")" 2>/dev/null &
	RUNNING=$((RUNNING + 1))
	if [ "$RUNNING" -ge "$JOBS" ]; then
		if [ "$HAVE_WAIT_N" -eq 1 ]; then
			wait -n 2>/dev/null
			RUNNING=$((RUNNING - 1))
		else
			wait
			RUNNING=0
		fi
	fi
done < <(discover)
wait

# Dedupe on the canonical toplevel in field 2, keeping discovery order. One
# repository with five worktrees stays five rows, because each worktree has its
# own toplevel; the several paths that reach a single checkout collapse to one.
# A process substitution, not a pipe, so RECORDS is built in this shell.
while IFS= read -r rec; do
	TOTAL_REPOS=$((TOTAL_REPOS + 1))
	case $rec in
	CLEAN*) CLEAN_REPOS=$((CLEAN_REPOS + 1)) ;;
	REPO*) RECORDS+=("${rec#REPO$'\t'}") ;;
	esac
done < <(cat "$WORKDIR"/rec/* 2>/dev/null | LC_ALL=C sort -t "$(printf '\t')" -u -k2,2)

if [ "$FORMAT" = paths ]; then
	for rec in ${RECORDS[@]+"${RECORDS[@]}"}; do
		printf '%s\n' "${rec%%$'\t'*}"
	done
	exit 0
fi

# -------------------------------------------------------- naming and phrasing
#
# Shared by both surfaces below - the since-you-last-looked journal and the table
# - so one worktree is named the same way and its work described in the same
# words wherever it appears. Defined up here because the journal is computed
# before the table is rendered, and a function has to exist before it is called.

# One repository can have more than one treehouse pool - a leftover beside a live
# one, or two programs of work running side by side - and then two worktrees hold
# the same slot number and the short label names them identically. This desk had
# three such collisions out of eighty rows. The pool is recorded per repository as
# the fleet is read, and the pool directory joins the label only for the
# repositories where it actually tells two rows apart, so an ordinary fleet of one
# pool per repository keeps the short name.
POOL_SEEN=
POOL_SHARED=
note_pool() {
	local path=$1 repo pool
	case $path in */.treehouse/*) ;; *) return 0 ;; esac
	repo=${path##*/}
	pool=${path#*/.treehouse/}
	pool=${pool%%/*}
	case $POOL_SEEN in
	*"|$repo=$pool|"*) return 0 ;;
	*"|$repo="*)
		case $POOL_SHARED in
		*"|$repo|"*) ;;
		*) POOL_SHARED="$POOL_SHARED|$repo|" ;;
		esac
		;;
	esac
	POOL_SEEN="$POOL_SEEN|$repo=$pool|"
}

# ~/.treehouse/mac-setup-cadbea/2/mac-setup -> "mac-setup #2". The pool hash and
# the repeated repository name carry nothing a reader needs; the slot number is
# the only part that distinguishes one agent's worktree from the next - unless the
# repository has two pools, which is what note_pool above is watching for.
agent_label() {
	local path=$1 slot repo pool
	repo=${path##*/}
	slot=${path%/*}
	slot=${slot##*/}
	case $slot in
	'' | *[!0-9]*)
		printf '%s\n' "$(abbrev "$path")"
		return 0
		;;
	esac
	case $POOL_SHARED in
	*"|$repo|"*)
		pool=${path#*/.treehouse/}
		pool=${pool%%/*}
		printf '%s #%s\n' "$pool" "$slot"
		;;
	*) printf '%s #%s\n' "$repo" "$slot" ;;
	esac
}

# The shortest honest name for a checkout, wherever it lives.
short_label() {
	case $1 in
	*/.treehouse/*) agent_label "$1" ;;
	*) abbrev "$1" ;;
	esac
}

plural() {
	[ "$1" -eq 1 ] && printf '%s\n' "$2" || printf '%ss\n' "$2"
}

# A count that can be arithmetic. Both commit counts are "?" when a checkout has
# no base branch to compare against, and "?" in an integer context is a fatal
# error, not a zero.
num() {
	case ${1:-} in
	'' | *[!0-9]*) printf '0\n' ;;
	*) printf '%s\n' "$1" ;;
	esac
}

# Only the parts that are non-zero, so a row never spends width saying "0".
#
# "commits to push" and "commits" are different facts and both matter: the first
# is work an upstream has not seen, the second work the base branch has not seen.
# An agent worktree has no upstream at all, so it only ever reports the second;
# reporting neither - which an earlier draft did whenever ahead was exactly 0 -
# printed "up to date" over a branch holding unmerged commits.
what_changed() {
	local ahead=$1 uniq=$2 sf=$3 uf=$4 nf=$5 out=
	local pushable unmerged
	pushable=$(num "$ahead")
	unmerged=$(num "$uniq")

	if [ "$pushable" -gt 0 ]; then
		out="$pushable $(plural "$pushable" commit) to push"
	elif [ "$unmerged" -gt 0 ]; then
		out="$unmerged $(plural "$unmerged" commit)"
	fi
	[ "$sf" -gt 0 ] && out="${out:+$out, }$sf staged"
	[ "$uf" -gt 0 ] && out="${out:+$out, }$uf edited"
	[ "$nf" -gt 0 ] && out="${out:+$out, }$nf new"
	printf '%s\n' "${out:-up to date}"
}

# A path is capped rather than only measured, because one deep checkout -
# ~/DataZoneServiceMeta/src/DataZoneServiceBrazilMetaRepo - is long enough to push
# every other row's columns out of line on its own. The tail is the half that
# identifies a checkout, so that is the half kept.
#
# The marker is ASCII ".." rather than a prettier "…" so that every string in
# these tables has one byte per column. awk's printf pads to a count of bytes, so
# a single three-byte ellipsis would leave its row two columns short of every
# other row - which is exactly the misalignment the table exists to avoid.
LABEL_CAP=40
fit_label() {
	local label=$1
	[ ${#label} -le "$LABEL_CAP" ] && {
		printf '%s\n' "$label"
		return 0
	}
	printf '..%s\n' "${label: -$((LABEL_CAP - 2))}"
}

# ---------------------------------------------------------- previous snapshot

# Each scan scope gets its own history. A fixture root, a shallow focused scan
# and the default whole-home scan must never overwrite one another's baseline.
STATE_SCOPE=$(
	{
		printf 'depth=%s\nall=%s\n' "$DEPTH" "$SHOW_ALL"
		for root in "${ROOTS[@]}"; do
			physical=$(cd -- "$root" 2>/dev/null && pwd -P) || physical=$root
			printf 'root=%s\n' "$physical"
		done
	} | cksum | awk '{ print $1 "-" $2 }'
)
STATE_DIR=${GIT_FLEET_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/git-fleet-status}
STATE_FILE="$STATE_DIR/$STATE_SCOPE.tsv"
STATE_VERSION='# git-fleet-status-v1'
PREVIOUS_AT=
CURRENT_AT=$(date '+%Y-%m-%d %H:%M:%S %Z')
HAS_PREVIOUS=0
PREVIOUS_RECORDS=()

if [ -r "$STATE_FILE" ]; then
	first=1
	while IFS= read -r line || [ -n "$line" ]; do
		if [ "$first" -eq 1 ]; then
			first=0
			IFS=$'\t' read -r version previous_at <<<"$line"
			if [ "$version" = "$STATE_VERSION" ]; then
				HAS_PREVIOUS=1
				PREVIOUS_AT=$previous_at
			else
				break
			fi
		elif [ "$HAS_PREVIOUS" -eq 1 ] && [ -n "$line" ]; then
			PREVIOUS_RECORDS+=("$line")
		fi
	done <"$STATE_FILE"
fi

previous_for_path() {
	local wanted=$1 old
	for old in ${PREVIOUS_RECORDS[@]+"${PREVIOUS_RECORDS[@]}"}; do
		if [ "${old%%$'\t'*}" = "$wanted" ]; then
			printf '%s\n' "$old"
			return 0
		fi
	done
	return 1
}

current_has_path() {
	local wanted=$1 current
	for current in ${RECORDS[@]+"${RECORDS[@]}"}; do
		if [ "${current%%$'\t'*}" = "$wanted" ]; then
			return 0
		fi
	done
	return 1
}

state_record() {
	local current=$1
	local top branch ahead uniq sf uf nf add del val pr full_head base fingerprint
	IFS=$'\t' read -r top branch ahead uniq sf uf nf add del val pr full_head base fingerprint <<<"$current"
	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
		"$top" "$branch" "$full_head" "$base" "$ahead" "$uniq" \
		"$sf" "$uf" "$nf" "$add" "$del" "$fingerprint"
}

# What moved on one checkout, in the words a person would use out loud.
#
# This used to print git's own state transitions - "ahead 0 -> 1; unique 14 -> 17;
# staged 0 -> 0; lines +0/-0 -> +13316/-2960" - which is arithmetic homework handed
# back to the reader. What they came to find out is what the work did, so a gained
# commit count is reported as a gain, and uncommitted work as it stands now.
updated_detail() {
	local old=$1 current=$2
	local obranch ofull_head obase ouniq osf ouf onf oadd odel ofingerprint
	local top branch ahead uniq sf uf nf add del val pr full_head base fingerprint
	local -a moved=()

	IFS=$'\t' read -r _ obranch ofull_head obase _ ouniq osf ouf onf oadd odel ofingerprint <<<"$old"
	IFS=$'\t' read -r top branch ahead uniq sf uf nf add del val pr full_head base fingerprint <<<"$current"

	[ "$obranch" = "$branch" ] || moved+=("moved to $branch")

	local was now gained
	was=$(num "$ouniq")
	now=$(num "$uniq")
	gained=$((now - was))
	if [ "$gained" -gt 0 ]; then
		moved+=("$gained more $(plural "$gained" commit)")
	elif [ "$gained" -lt 0 ]; then
		# Fewer commits than last time means a rebase or a reset, not work thrown
		# away, and "-3 commits" would say the opposite.
		moved+=('history rewritten')
	elif [ "$ofull_head" != "$full_head" ]; then
		moved+=('recommitted')
	fi

	# Every count can match while the work is different - the same line edited
	# twice, or a rebase onto a base that moved. Say so rather than say nothing.
	if [ ${#moved[@]} -eq 0 ] &&
		[ "$osf" = "$sf" ] && [ "$ouf" = "$uf" ] && [ "$onf" = "$nf" ] &&
		[ "$oadd" = "$add" ] && [ "$odel" = "$del" ]; then
		if [ "$ofingerprint" != "$fingerprint" ]; then
			moved+=('same counts, different content')
		elif [ "$obase" != "$base" ]; then
			moved+=("compared against $base now")
		else
			moved+=('changed')
		fi
	fi

	# What moved, then where that left it - in the same words the table uses, and
	# behind one "now" so a total is never misread as a difference. "+4/-0" on its
	# own is the whole diff, not four lines added since the last look.
	local state
	state=$(what_changed "$ahead" "$uniq" "$sf" "$uf" "$nf")
	[ $((add + del)) -gt 0 ] && state="$state, +$add/-$del"

	local detail='' part
	for part in ${moved[@]+"${moved[@]}"}; do
		[ -z "$detail" ] || detail="$detail, "
		detail="$detail$part"
	done
	printf '%s\n' "${detail:+$detail; }now $state"
}

new_detail() {
	local current=$1
	local top branch ahead uniq sf uf nf add del val pr full_head base fingerprint
	local detail
	IFS=$'\t' read -r top branch ahead uniq sf uf nf add del val pr full_head base fingerprint <<<"$current"
	detail=$(what_changed "$ahead" "$uniq" "$sf" "$uf" "$nf")
	[ $((add + del)) -gt 0 ] && detail="$detail, +$add/-$del"
	printf '%s\n' "$detail"
}

# "NEW", "UPDATED" and "CLEARED" name a state in a data structure. These name
# what happened to the work, which is the same information and needs no decoding.
journal_verb() {
	case $1 in
	new) printf 'started\n' ;;
	updated) printf 'changed\n' ;;
	cleared) printf 'gone\n' ;;
	*) printf '%s\n' "$1" ;;
	esac
}

# Every path that will be named, before anything is named: both what is here now and
# what the baseline held, because a live pool and a finished one colliding on a slot
# number is the common case for this. Nothing below may call short_label until this
# has run, or the same worktree gets two different labels in one page.
for rec in ${RECORDS[@]+"${RECORDS[@]}"}; do
	IFS=$'\t' read -r top _ <<<"$rec"
	note_pool "$top"
done
for old in ${PREVIOUS_RECORDS[@]+"${PREVIOUS_RECORDS[@]}"}; do
	IFS=$'\t' read -r old_top _ <<<"$old"
	note_pool "$old_top"
done

ACTIVITY=()
ACTIVITY_DETAILS=()
ACTIVITY_LABELS=()
ACTIVITY_ROWS=()
ACTIVITY_COUNT=0

for rec in ${RECORDS[@]+"${RECORDS[@]}"}; do
	IFS=$'\t' read -r top _ <<<"$rec"
	activity=baseline
	detail=
	label=
	if [ "$HAS_PREVIOUS" -eq 1 ]; then
		old=$(previous_for_path "$top") || old=
		if [ -z "$old" ]; then
			activity=new
			detail=$(new_detail "$rec")
		else
			current_state=$(state_record "$rec")
			if [ "$old" = "$current_state" ]; then
				activity=unchanged
			else
				activity=updated
				detail=$(updated_detail "$old" "$rec")
			fi
		fi
		if [ "$activity" = new ] || [ "$activity" = updated ]; then
			label=$(fit_label "$(short_label "$top")")
			ACTIVITY_COUNT=$((ACTIVITY_COUNT + 1))
		fi
	fi
	ACTIVITY+=("$activity")
	ACTIVITY_DETAILS+=("$detail")
	ACTIVITY_LABELS+=("$label")
	ACTIVITY_ROWS+=('')
done

CLEARED_RECORDS=()
CLEARED_DETAILS=()
CLEARED_LABELS=()
CLEARED_ROWS=()
if [ "$HAS_PREVIOUS" -eq 1 ]; then
	for old in ${PREVIOUS_RECORDS[@]+"${PREVIOUS_RECORDS[@]}"}; do
		IFS=$'\t' read -r old_top old_branch _ <<<"$old"
		current_has_path "$old_top" && continue
		if git -C "$old_top" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
			detail="nothing left to show (was $old_branch)"
		else
			detail="checkout no longer there (was $old_branch)"
		fi
		CLEARED_RECORDS+=("$old")
		CLEARED_DETAILS+=("$detail")
		CLEARED_LABELS+=("$(fit_label "$(short_label "$old_top")")")
		CLEARED_ROWS+=('')
		ACTIVITY_COUNT=$((ACTIVITY_COUNT + 1))
	done
fi

# Rows are built in a second pass because the name column is sized to the widest
# name in the journal, and that is not known until every entry has been named.
W_JOURNAL=4
for label in ${ACTIVITY_LABELS[@]+"${ACTIVITY_LABELS[@]}"} ${CLEARED_LABELS[@]+"${CLEARED_LABELS[@]}"}; do
	[ ${#label} -gt "$W_JOURNAL" ] && W_JOURNAL=${#label}
done

i=0
for activity in ${ACTIVITY[@]+"${ACTIVITY[@]}"}; do
	if [ -n "${ACTIVITY_LABELS[$i]}" ]; then
		ACTIVITY_ROWS[i]=$(printf '  %-7s  %-*s  %s' "$(journal_verb "$activity")" \
			"$W_JOURNAL" "${ACTIVITY_LABELS[$i]}" "${ACTIVITY_DETAILS[$i]}")
	fi
	i=$((i + 1))
done

i=0
for label in ${CLEARED_LABELS[@]+"${CLEARED_LABELS[@]}"}; do
	CLEARED_ROWS[i]=$(printf '  %-7s  %-*s  %s' "$(journal_verb cleared)" \
		"$W_JOURNAL" "$label" "${CLEARED_DETAILS[$i]}")
	i=$((i + 1))
done

# Save only after a successful complete scan. The rename is atomic, so two
# editor/terminal scans can race without ever leaving a partial snapshot.
if [ "$SAVE" -eq 0 ]; then
	:
elif mkdir -p "$STATE_DIR" 2>/dev/null; then
	state_tmp="$STATE_DIR/.$STATE_SCOPE.$$.tmp"
	if (
		umask 077
		{
			printf '%s\t%s\n' "$STATE_VERSION" "$CURRENT_AT"
			for rec in ${RECORDS[@]+"${RECORDS[@]}"}; do
				state_record "$rec"
			done
		} >"$state_tmp" &&
			mv -f "$state_tmp" "$STATE_FILE"
	); then
		:
	else
		rm -f "$state_tmp"
		printf '%s: could not save snapshot at %s\n' "$PROG" "$STATE_FILE" >&2
	fi
else
	printf '%s: could not create snapshot directory %s\n' "$PROG" "$STATE_DIR" >&2
fi

# ----------------------------------------------------------- one row per record
#
# Named, described and measured once, because four surfaces show the same rows and
# any of them formatting its own is how two views of one fleet start disagreeing:
# the table below, the JSON "row" field that the Neovim picker and
# git-fleet-diff --repos display verbatim, and the HTML report. What a reader sees
# is plain words - "9 commits to push, 1 edited" - and the raw counts stay
# available beside them as their own JSON fields for anything that computes.
KINDS=()
NAMES=()
FITTED=()
BRANCHES=()
WHATS=()
SIZES=()
KEYS=()
W_NAME=4
W_WHAT=4
T_A=0
T_D=0
for rec in ${RECORDS[@]+"${RECORDS[@]}"}; do
	IFS=$'\t' read -r top branch ahead uniq sf uf nf add del val pr full_head base fingerprint <<<"$rec"
	# The two unrelated kinds of work in a fleet, decided here so no other surface
	# has to know what a treehouse path looks like.
	case $top in
	*/.treehouse/*) KINDS+=(agent) ;;
	*) KINDS+=(mine) ;;
	esac
	what=$(what_changed "$ahead" "$uniq" "$sf" "$uf" "$nf")
	# A detached HEAD arrives as its own abbreviated sha in brackets, which is noise
	# in a column: the fact worth a reader's attention is that there is no branch.
	case $branch in
	'('*')') branch='detached' ;;
	esac
	[ ${#branch} -gt 24 ] && branch="${branch:0:22}.."
	lines='·'
	[ $((add + del)) -gt 0 ] && lines="+$add/-$del"
	# Only what was actually looked up. Both are opt-in and report "?" when they
	# were not asked for, and a column of question marks was most of what made the
	# old table unreadable - so the unasked answer is simply not shown. It is the
	# last field on the row, where a variable width costs no alignment.
	[ "$val" = '?' ] || lines="$lines  tests $val"
	[ "$pr" = '?' ] || lines="$lines  PR $pr"
	name=$(short_label "$top")
	fitted=$(fit_label "$name")
	KEYS+=("$((add + del))")
	NAMES+=("$name")
	FITTED+=("$fitted")
	BRANCHES+=("$branch")
	WHATS+=("$what")
	SIZES+=("$lines")
	[ ${#fitted} -gt "$W_NAME" ] && W_NAME=${#fitted}
	[ ${#what} -gt "$W_WHAT" ] && W_WHAT=${#what}
	T_A=$((T_A + add))
	T_D=$((T_D + del))
done

ROWS=()
i=0
while [ "$i" -lt ${#FITTED[@]} ]; do
	ROWS+=("$(printf '%-*s  %-24s  %-*s  %s' \
		"$W_NAME" "${FITTED[$i]}" "${BRANCHES[$i]}" "$W_WHAT" "${WHATS[$i]}" "${SIZES[$i]}")")
	i=$((i + 1))
done

if [ "$FORMAT" = json ]; then
	[ "$HAS_PREVIOUS" -eq 1 ] && has_previous=true || has_previous=false
	printf '{"type":"meta","hasPrevious":%s,"previousAt":"%s","currentAt":"%s",' \
		"$has_previous" "$(json_escape "$PREVIOUS_AT")" "$(json_escape "$CURRENT_AT")"
	printf '"activityCount":%d,"currentCount":%d}\n' "$ACTIVITY_COUNT" "${#RECORDS[@]}"

	i=0
	for rec in ${RECORDS[@]+"${RECORDS[@]}"}; do
		IFS=$'\t' read -r top branch ahead uniq sf uf nf add del val pr full_head base fingerprint <<<"$rec"
		printf '{"type":"repo","path":"%s","label":"%s","branch":"%s","head":"%s",' \
			"$(json_escape "$top")" "$(json_escape "$(abbrev "$top")")" \
			"$(json_escape "$branch")" "$(json_escape "$full_head")"
		# kind, name, what and lines are the row taken apart, for a consumer that
		# lays out its own columns - the HTML report - rather than printing "row".
		# name is uncapped here: the cap exists to keep a terminal table aligned and
		# costs a reader the head of a long path for nothing anywhere else.
		# branchLabel is the branch as the table says it: a detached HEAD reads
		# "detached" rather than "(c70f8c2)", which is the same fact and the one an
		# agent worktree's reader can act on. The raw "branch" above stays as git
		# reported it, for a consumer that wants the hash.
		printf '"kind":"%s","name":"%s","branchLabel":"%s","what":"%s","lines":"%s",' \
			"${KINDS[$i]}" "$(json_escape "$(short_label "$top")")" \
			"$(json_escape "${BRANCHES[$i]}")" \
			"$(json_escape "${WHATS[$i]}")" "${SIZES[$i]}"
		printf '"base":"%s","ahead":"%s","unique":"%s",' \
			"$(json_escape "$base")" "$ahead" "$uniq"
		printf '"staged":%d,"unstaged":%d,"untracked":%d,"added":%d,"deleted":%d,' \
			"$sf" "$uf" "$nf" "$add" "$del"
		# activity is the state; activityVerb is what happened, in the word the table
		# uses. Carried here so a consumer laying out its own journal says "started"
		# where this one does, instead of keeping a second copy of the mapping that
		# can drift into calling the same event something else.
		printf '"validation":"%s","pr":"%s","activity":"%s","activityVerb":"%s",' \
			"$(json_escape "$val")" "$(json_escape "$pr")" "${ACTIVITY[$i]}" \
			"$(journal_verb "${ACTIVITY[$i]}")"
		printf '"activityDetail":"%s","activityRow":"%s","row":"%s"}\n' \
			"$(json_escape "${ACTIVITY_DETAILS[$i]}")" "$(json_escape "${ACTIVITY_ROWS[$i]}")" \
			"$(json_escape "${ROWS[$i]}")"
		i=$((i + 1))
	done
	i=0
	for old in ${CLEARED_RECORDS[@]+"${CLEARED_RECORDS[@]}"}; do
		IFS=$'\t' read -r old_top old_branch old_head old_base _ <<<"$old"
		printf '{"type":"cleared","path":"%s","label":"%s","branch":"%s","head":"%s",' \
			"$(json_escape "$old_top")" "$(json_escape "$(abbrev "$old_top")")" \
			"$(json_escape "$old_branch")" "$(json_escape "$old_head")"
		# name, same as a live record carries: an agent worktree that finished still
		# belongs in the journal as "proj #4". Without it a consumer falls back to the
		# path, and six worktrees of one repository under .treehouse then read as six
		# identical rows - the one place the slot number is the whole answer.
		printf '"name":"%s","base":"%s","activity":"cleared","activityVerb":"gone",' \
			"$(json_escape "$(short_label "$old_top")")" "$(json_escape "$old_base")"
		printf '"activityDetail":"%s","activityRow":"%s"}\n' \
			"$(json_escape "${CLEARED_DETAILS[$i]}")" \
			"$(json_escape "${CLEARED_ROWS[$i]}")"
		i=$((i + 1))
	done
	exit 0
fi

# One screen, not one scroll.
#
# A machine running a dozen agents has 87 changed checkouts, and printing all of
# them pushed everything worth reading off the top of the terminal - which is the
# same unreadability this output exists to fix, just by volume instead of by
# vocabulary. So each list stops, and says plainly how many it stopped short of.
# The table's lists are ordered loudest-first, so what a cap hides there is always
# the quietest work; --all holds nothing back anywhere.
JOURNAL_CAP=8
SECTION_CAP=12
if [ "$SHOW_ALL" -eq 1 ]; then
	JOURNAL_CAP=0
	SECTION_CAP=0
fi

printf 'SINCE YOU LAST LOOKED'
if [ "$HAS_PREVIOUS" -eq 1 ]; then
	printf ' (%s)\n' "$PREVIOUS_AT"
	if [ "$ACTIVITY_COUNT" -eq 0 ]; then
		printf '%s\n' '  Nothing has changed anywhere since then.'
	else
		shown=0
		for activity_row in ${ACTIVITY_ROWS[@]+"${ACTIVITY_ROWS[@]}"} \
			${CLEARED_ROWS[@]+"${CLEARED_ROWS[@]}"}; do
			[ -n "$activity_row" ] || continue
			[ "$JOURNAL_CAP" -gt 0 ] && [ "$shown" -ge "$JOURNAL_CAP" ] && break
			printf '%s\n' "$activity_row"
			shown=$((shown + 1))
		done
		[ "$ACTIVITY_COUNT" -gt "$shown" ] &&
			printf '  and %d more (--all shows every one).\n' "$((ACTIVITY_COUNT - shown))"
	fi
else
	printf '\n%s\n' '  Baseline saved. Next time, this will say what changed since now.'
fi

if [ ${#RECORDS[@]} -eq 0 ]; then
	printf '\nNOTHING IS CHANGED ANYWHERE\n'
	if [ "$CLEAN_REPOS" -gt 0 ]; then
		printf '%s\n' "All $TOTAL_REPOS repositories are clean."
	else
		printf '%s\n' "No repositories found below: ${ROOTS[*]}"
	fi
	exit 0
fi

# ------------------------------------------------------- plain-language rows
#
# The columns this used to print - AHEAD UNIQ STG UNS UNT - are git's words, not
# a reader's, and a row of five bare integers has to be decoded before it means
# anything. So each row now says what happened in the words someone would use
# out loud: "7 commits to push, 3 files edited, 1 new". The numbers are the same
# ones; only the labelling changed.
#
# Two sections, because the fleet holds two unrelated kinds of work and mixing
# them is what made one list unreadable: checkouts the reader edits themselves,
# and the detached-HEAD worktrees agents were given. Within each, the biggest
# diff comes first - the row worth reading is almost never the alphabetical one.

# sortkey<TAB>name<TAB>branch<TAB>what<TAB>lines, split by section, every field
# taken from the single pass above rather than derived again here. The sort key is
# total lines touched, so `sort -rn` alone puts the loudest row on top.
MINE=()
AGENTS=()
i=0
while [ "$i" -lt ${#KINDS[@]} ]; do
	entry="${KEYS[$i]}"$'\t'"${FITTED[$i]}"$'\t'"${BRANCHES[$i]}"$'\t'"${WHATS[$i]}"$'\t'"${SIZES[$i]}"
	case ${KINDS[$i]} in
	agent) AGENTS+=("$entry") ;;
	*) MINE+=("$entry") ;;
	esac
	i=$((i + 1))
done

# Loudest first, then the cap. Ordering and truncating here rather than at print
# time is what lets the column widths below be measured against the rows a reader
# will actually see: measuring a row the cap hides pads every visible row out to a
# width nothing on screen occupies.
take_top() {
	local cap=$1 n=0 row
	shift
	while IFS= read -r row; do
		[ -n "$row" ] || continue
		[ "$cap" -gt 0 ] && [ "$n" -ge "$cap" ] && break
		printf '%s\n' "$row"
		n=$((n + 1))
	done < <(printf '%s\n' "$@" | sort -t$'\t' -k1,1rn)
}

MINE_SHOWN=()
while IFS= read -r entry; do
	[ -n "$entry" ] && MINE_SHOWN+=("$entry")
done < <(take_top "$SECTION_CAP" ${MINE[@]+"${MINE[@]}"})

AGENTS_SHOWN=()
while IFS= read -r entry; do
	[ -n "$entry" ] && AGENTS_SHOWN+=("$entry")
done < <(take_top "$SECTION_CAP" ${AGENTS[@]+"${AGENTS[@]}"})

# Every field is ASCII by construction, so a character count is also a byte count
# and awk's byte padding lands where these widths say it will. Measured across
# both sections so the two line up as one page rather than as two tables.
W_LABEL=4
W_BRANCH=6
W_WHAT=4
for entry in ${MINE_SHOWN[@]+"${MINE_SHOWN[@]}"} ${AGENTS_SHOWN[@]+"${AGENTS_SHOWN[@]}"}; do
	IFS=$'\t' read -r _ f_label f_branch f_what _ <<<"$entry"
	[ ${#f_label} -gt "$W_LABEL" ] && W_LABEL=${#f_label}
	[ ${#f_branch} -gt "$W_BRANCH" ] && W_BRANCH=${#f_branch}
	[ ${#f_what} -gt "$W_WHAT" ] && W_WHAT=${#f_what}
done

print_section() {
	local title=$1 total=$2 shown=$3
	shift 3
	[ "$total" -gt 0 ] || return 0
	printf '\n%s (%d)\n' "$title" "$total"
	printf '%s\n' "$@" | awk -F'\t' \
		-v w1="$W_LABEL" -v w2="$W_BRANCH" -v w3="$W_WHAT" '
    { printf "  %-*s  %-*s  %-*s  %s\n", w1, $2, w2, $3, w3, $4, $5 }
  '
	local hidden=$((total - shown))
	[ "$hidden" -gt 0 ] &&
		printf '  and %d more, all smaller than these (--all shows every row).\n' "$hidden"
	return 0
}

print_section 'YOUR CHECKOUTS' "${#MINE[@]}" "${#MINE_SHOWN[@]}" \
	${MINE_SHOWN[@]+"${MINE_SHOWN[@]}"}
print_section 'AGENT WORKTREES' "${#AGENTS[@]}" "${#AGENTS_SHOWN[@]}" \
	${AGENTS_SHOWN[@]+"${AGENTS_SHOWN[@]}"}

printf '\n%d changed, +%d/-%d lines total.' "${#RECORDS[@]}" "$T_A" "$T_D"
[ "$CLEAN_REPOS" -gt 0 ] && printf ' %d clean and hidden (--all shows them).' "$CLEAN_REPOS"
printf '\n'
printf '%s\n' 'Read any of it:  fleet-diff   (arrow keys, enter to read, esc to quit)'
