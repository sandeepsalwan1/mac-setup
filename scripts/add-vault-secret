#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
SECRET_NAMES_FILE="${SECRET_NAMES_FILE:-$ROOT/vault/secret-names.txt}"
PERMISSIONS_BIN="${PERMISSIONS_BIN:-$ROOT/scripts/setup-macos-permissions}"
VAULT_ACCESS_BIN="${VAULT_ACCESS_BIN:-$ROOT/scripts/setup-vault-access}"
AV_BIN="${AV_BIN:-$(command -v av 2>/dev/null || true)}"
PROJECT_DIRECTORY=''
REPLACE=0
DECLARE=1
APPROVAL_REQUIRED=0
SECRET_NAME=''
ORIGINAL_ARGS=("$@")

usage() {
	printf '%s\n' \
		'Usage: add-vault-secret [options] SECRET_NAME' \
		'' \
		'Options:' \
		'  --project-directory DIR  Save a Project Value selected below DIR.' \
		'  --replace                Replace an effective Value in the selected scope.' \
		'  --no-declare             Do not append the name to the public manifest.' \
		'  --approval-required      Keep per-use Approval instead of guiding broad access.' \
		'' \
		'The Value is read only by av save through hidden /dev/tty input.'
}

note() {
	printf 'add-vault-secret: %s\n' "$1"
}

die() {
	printf 'add-vault-secret: %s\n' "$1" >&2
	exit 1
}

while [ "$#" -gt 0 ]; do
	case "$1" in
	--project-directory)
		[ "$#" -ge 2 ] || die '--project-directory requires a directory'
		PROJECT_DIRECTORY=$2
		shift
		;;
	--replace) REPLACE=1 ;;
	--no-declare) DECLARE=0 ;;
	--approval-required) APPROVAL_REQUIRED=1 ;;
	-h | --help)
		usage
		exit 0
		;;
	-*)
		usage >&2
		exit 64
		;;
	*)
		[ -z "$SECRET_NAME" ] || die 'provide exactly one Secret Name'
		SECRET_NAME=$1
		;;
	esac
	shift
done

case "$SECRET_NAME" in
'' | *[!A-Za-z0-9_]*) die 'Secret Name must contain only letters, digits, and underscores' ;;
[0-9]*) die 'Secret Name must begin with a letter or underscore' ;;
esac

if ! "$PERMISSIONS_BIN" --check-wezterm >/dev/null 2>&1; then
	[ "${MAC_SETUP_VAULT_RELAUNCHED:-0}" != 1 ] ||
		die 'the relaunched process is still not directly owned by WezTerm'
	WEZTERM_BIN="${WEZTERM_BIN:-$(command -v wezterm 2>/dev/null || true)}"
	[ -n "$WEZTERM_BIN" ] || die 'wezterm is unavailable; run bootstrap.sh first'
	"$WEZTERM_BIN" start --new-tab --cwd "$PWD" -- \
		/usr/bin/env MAC_SETUP_VAULT_RELAUNCHED=1 "$ROOT/scripts/add-vault-secret" "${ORIGINAL_ARGS[@]}"
	note 'opened secret onboarding in a direct WezTerm tab'
	exit 0
fi

[ -n "$AV_BIN" ] || die 'Automic Vault is unavailable; run bootstrap.sh first'
[ -r "$SECRET_NAMES_FILE" ] || die "missing Secret Name manifest: $SECRET_NAMES_FILE"

canonical_project=''
if [ -n "$PROJECT_DIRECTORY" ]; then
	canonical_project="$(cd "$PROJECT_DIRECTORY" && pwd -P)" ||
		die "project directory is unavailable: $PROJECT_DIRECTORY"
	saved_names="$(cd "$canonical_project" && "$AV_BIN" list)"
else
	saved_names="$("$AV_BIN" list)"
fi

should_save=1
if printf '%s\n' "$saved_names" | grep -Fqx -- "$SECRET_NAME"; then
	if [ "$REPLACE" -eq 1 ]; then
		if [ -n "$canonical_project" ]; then
			note "$SECRET_NAME exists; replacing its Project Value through hidden input"
		else
			note "$SECRET_NAME exists; replacing its Global Value through hidden input"
		fi
	else
		note "$SECRET_NAME is already effective in this scope; leaving its Value untouched"
		should_save=0
	fi
fi

if [ "$should_save" -eq 1 ]; then
	if [ -n "$canonical_project" ]; then
		note "saving a Project Value for $SECRET_NAME under $canonical_project"
		"$AV_BIN" save --project-directory="$canonical_project" "$SECRET_NAME"
	else
		note "saving a Global Value for $SECRET_NAME"
		"$AV_BIN" save "$SECRET_NAME"
	fi
fi

if [ "$DECLARE" -eq 1 ]; then
	if ! grep -Fqx -- "$SECRET_NAME" "$SECRET_NAMES_FILE"; then
		printf '%s\n' "$SECRET_NAME" >>"$SECRET_NAMES_FILE"
		note "$SECRET_NAME was added to the public Secret Name manifest; review it before committing"
	else
		note "$SECRET_NAME is already declared in the public manifest"
	fi
fi

if [ "$APPROVAL_REQUIRED" -eq 1 ]; then
	"$AV_BIN" open
	note 'kept per-use Approval Required; no Full or Direct Access guide was applied'
else
	"$VAULT_ACCESS_BIN" --secret "$SECRET_NAME"
fi

note 'Secret onboarding completed without reading or printing the Value'
