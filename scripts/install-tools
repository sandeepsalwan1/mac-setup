#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
NPM_GLOBALS_FILE="${NPM_GLOBALS_FILE:-$ROOT/home/npm-globals.txt}"
NPM_PREFIX="${NPM_PREFIX:-$HOME/.local/share/npm}"

note() {
	printf 'install-tools: %s\n' "$1"
}

die() {
	printf 'install-tools: %s\n' "$1" >&2
	exit 1
}

stop_default_chrome_bridge() {
	local bridge_axi

	bridge_axi="$(command -v chrome-devtools-axi 2>/dev/null || true)"
	[ -n "$bridge_axi" ] || return 0
	(
		unset CHROME_DEVTOOLS_AXI_PORT CHROME_DEVTOOLS_AXI_SESSION
		"$bridge_axi" stop
	)
}

install_npm_tools() {
	local npm_bin spec package_name wanted_version installed_version install_status recycle_pending
	local chrome_bridge_changed=0

	if [ "${MAC_SETUP_SKIP_NPM:-0}" = "1" ]; then
		note 'npm tool installation skipped by environment'
		return
	fi

	npm_bin="${NPM_BIN:-$(command -v npm 2>/dev/null || true)}"
	[ -n "$npm_bin" ] || die 'npm is unavailable after the Nix activation'
	[ -r "$NPM_GLOBALS_FILE" ] || die "missing npm manifest: $NPM_GLOBALS_FILE"

	mkdir -p "$NPM_PREFIX"
	export NPM_CONFIG_PREFIX="$NPM_PREFIX"
	export PATH="$NPM_PREFIX/bin:$PATH"
	recycle_pending="$NPM_PREFIX/.chrome-devtools-axi-recycle-pending"

	while IFS= read -r spec || [ -n "$spec" ]; do
		case "$spec" in
		'' | '#'*) continue ;;
		esac

		package_name="${spec%@*}"
		case "$package_name" in
		chrome-devtools-axi | chrome-devtools-mcp) ;;
		*) continue ;;
		esac
		wanted_version="${spec##*@}"
		installed_version=''
		if command -v "$package_name" >/dev/null 2>&1; then
			installed_version="$("$package_name" --version 2>/dev/null | head -n 1 || true)"
		fi
		if [ "$installed_version" != "$wanted_version" ]; then
			chrome_bridge_changed=1
		fi
	done <"$NPM_GLOBALS_FILE"

	if [ -e "$recycle_pending" ]; then
		chrome_bridge_changed=1
	fi

	if [ "$chrome_bridge_changed" = "1" ]; then
		: >"$recycle_pending"
		note 'recycling the default Chrome DevTools AXI bridge before tool changes'
		stop_default_chrome_bridge
	fi

	install_status=0
	while IFS= read -r spec || [ -n "$spec" ]; do
		case "$spec" in
		'' | '#'*) continue ;;
		esac

		package_name="${spec%@*}"
		wanted_version="${spec##*@}"
		installed_version=''
		if command -v "$package_name" >/dev/null 2>&1; then
			installed_version="$("$package_name" --version 2>/dev/null | head -n 1 || true)"
		fi

		if [ "$installed_version" = "$wanted_version" ]; then
			note "$package_name $wanted_version is already installed"
			continue
		fi

		note "installing $spec"
		if "$npm_bin" install --global --prefix "$NPM_PREFIX" "$spec"; then
			continue
		else
			install_status=$?
			break
		fi
	done <"$NPM_GLOBALS_FILE"

	if [ "$chrome_bridge_changed" = "1" ]; then
		note 'ensuring the default Chrome DevTools AXI bridge remains stopped after tool changes'
		stop_default_chrome_bridge
		rm -f "$recycle_pending"
	fi
	[ "$install_status" -eq 0 ] || return "$install_status"
}

cleanup_chrome_devtools_hooks() {
	local settings temp plugin marker
	marker='chrome-devtools-axi'

	for settings in "$HOME/.claude/settings.json" "$HOME/.codex/hooks.json"; do
		[ -f "$settings" ] || continue
		temp="$(mktemp "${settings}.tmp.XXXXXX")"
		if ! jq --arg marker "$marker" '
			def managed:
				type == "object"
				and (.command? | type == "string" and contains($marker));
			if (.hooks | type) == "object" then
				.hooks |= (
					if (.SessionStart | type) == "array" then
						.SessionStart |= map(
							if (.hooks | type) == "array" then
								.hooks |= map(select(managed | not))
							else . end
						)
						| .SessionStart |= map(select((.hooks | type) != "array" or (.hooks | length) > 0))
					else . end
					| if (.session_start | type) == "array" then
						.session_start |= map(select(managed | not))
					else . end
				)
			else . end
		' "$settings" >"$temp"; then
			rm -f "$temp"
			die "could not clean managed Chrome hooks from $settings"
		fi
		if cmp -s "$settings" "$temp"; then
			rm -f "$temp"
		else
			mv "$temp" "$settings"
			note "removed managed Chrome hooks from $settings"
		fi
	done

	plugin="$HOME/.config/opencode/plugins/axi-chrome-devtools-axi.js"
	if [ -f "$plugin" ] && grep -Fq 'axi-sdk-js managed opencode plugin: chrome-devtools-axi' "$plugin"; then
		rm -f "$plugin"
		note "removed managed Chrome hook from $plugin"
	fi
}

install_command_guard() {
	local source_dir="$ROOT/home/.agents/hooks"
	local target_dir="$HOME/.agents/hooks"
	local name mode source target settings temp command_path

	mkdir -p "$target_dir"
	for name in dangerous-patterns.txt deny-dangerous.sh test-guard.sh; do
		source="$source_dir/$name"
		target="$target_dir/$name"
		case "$name" in
		*.sh) mode=0755 ;;
		*) mode=0644 ;;
		esac
		if [ -f "$target" ] && cmp -s "$source" "$target"; then
			chmod "$mode" "$target"
			continue
		fi
		install -m "$mode" "$source" "$target"
	done

	command_path="$target_dir/deny-dangerous.sh"
	for settings in "$HOME/.claude/settings.json" "$HOME/.codex/hooks.json"; do
		mkdir -p "$(dirname "$settings")"
		[ -f "$settings" ] || printf '{}\n' >"$settings"
		temp="$(mktemp "${settings}.tmp.XXXXXX")"
		if ! jq \
			--arg command "$command_path" \
			--arg settings "$settings" \
			--arg claude_settings "$HOME/.claude/settings.json" '
			def managed:
				type == "object"
				and .type? == "command"
				and (.command? | type == "string" and endswith("/.agents/hooks/deny-dangerous.sh"));
			if $settings == $claude_settings
			   and (.permissions? | type) == "object"
			   and (.permissions.deny? | type) == "array"
			then .permissions.deny |= map(select(
				. != "Bash(rm -rf /)"
				and . != "Bash(rm -rf ~*)"
				and . != "Bash(rm -rf /*)"
			))
			else . end
			| if (.hooks? == null) then .hooks = {}
			elif (.hooks | type) != "object" then error("hooks must be an object")
			else . end
			| if (.hooks.PreToolUse? == null) then .hooks.PreToolUse = []
			  elif (.hooks.PreToolUse | type) != "array" then error("hooks.PreToolUse must be an array")
			  else . end
			| .hooks.PreToolUse |= map(
				if type != "object" or (.hooks | type) != "array"
				then error("PreToolUse entries must contain a hooks array")
				else .hooks |= map(select(managed | not))
				end
			)
			| .hooks.PreToolUse |= map(select(.hooks | length > 0))
			| .hooks.PreToolUse += [{
				matcher: "Bash",
				hooks: [{type: "command", command: $command, timeout: 3}]
			}]
		' "$settings" >"$temp"; then
			rm -f "$temp"
			die "could not merge the command guard into $settings"
		fi
		if cmp -s "$settings" "$temp"; then
			rm -f "$temp"
		else
			chmod 600 "$temp"
			mv "$temp" "$settings"
			note "installed the command guard in $settings"
		fi
	done

	"$target_dir/test-guard.sh" "$target_dir/deny-dangerous.sh" >/dev/null ||
		die 'command guard self-test failed'
}

install_npm_tools
cleanup_chrome_devtools_hooks
install_command_guard
