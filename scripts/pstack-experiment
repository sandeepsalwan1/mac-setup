#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/agent-skills"
DISABLED="$STATE_DIR/pstack.disabled"
PROFILE_OWNER="$STATE_DIR/profile-owner"
PUBLIC_SKILLS="$ROOT/skills"
PRIVATE_SKILLS="$HOME/.local/share/agent-skills"
ROOTS=(
	"$HOME/.skills"
	"$HOME/.agents/skills"
	"$HOME/.claude/skills"
	"$HOME/.kiro/skills"
	"$HOME/.pi/agent/skills"
	"$HOME/.cursor/skills"
	"$HOME/.hermes/skills"
	"${CODEX_HOME:-$HOME/.codex}/skills"
	"${XDG_STATE_HOME:-$HOME/.local/state}/pi-firstmate/agent/skills"
)
NAMES=()
for source_dir in "$PUBLIC_SKILLS"/pstack-*; do
	[ -f "$source_dir/SKILL.md" ] || continue
	NAMES+=("${source_dir##*/}")
done

die() {
	printf 'pstack: %s\n' "$1" >&2
	exit 1
}

managed_target() {
	local target="$1" name="$2" resolved candidate
	[ -L "$target" ] || return 1
	for candidate in "$PUBLIC_SKILLS/$name" "$PRIVATE_SKILLS/$name"; do
		[ "$(readlink "$target")" != "$candidate" ] || return 0
		resolved="$(cd "$target" 2>/dev/null && pwd -P)" || continue
		[ "$(cd "$candidate" 2>/dev/null && pwd -P)" != "$resolved" ] || return 0
	done
	return 1
}

case "${1:-status}" in
on | off | status) action="${1:-status}" ;;
*) die "usage: scripts/pstack-experiment on|off|status" ;;
esac
[ "$#" -le 1 ] || die "usage: scripts/pstack-experiment on|off|status"
[ "${#NAMES[@]}" -gt 0 ] || die "pstack source is missing"
if [ -L "$DISABLED" ] || { [ -e "$DISABLED" ] && [ ! -f "$DISABLED" ]; }; then
	die "preserving an unowned marker: $DISABLED"
fi

managed=0
for skill_root in "${ROOTS[@]}"; do
	for name in pstack "${NAMES[@]}"; do
		target="$skill_root/$name"
		if managed_target "$target" "$name"; then
			managed=$((managed + 1))
		elif [ -e "$target" ] || [ -L "$target" ]; then
			die "preserving an unowned path: $target"
		fi
	done
done

if [ "$action" = status ]; then
	if [ -e "$DISABLED" ]; then
		printf 'pstack: off; %s managed discovery paths\n' "$managed"
	else
		printf 'pstack: on; %s managed discovery paths\n' "$managed"
	fi
	exit 0
fi

if [ "$action" = off ]; then
	mkdir -p "$STATE_DIR"
	if [ ! -e "$DISABLED" ]; then
		(
			set -o noclobber
			: >"$DISABLED"
		)
	fi
else
	if [ -f "$PRIVATE_SKILLS/pstack-poteto-mode/SKILL.md" ]; then
		source_root="$PRIVATE_SKILLS"
	elif [ -s "$PROFILE_OWNER" ]; then
		die "shared profile owns skills; its canonical pstack source is missing"
	else
		source_root="$PUBLIC_SKILLS"
	fi
	for name in "${NAMES[@]}"; do
		[ -f "$source_root/$name/SKILL.md" ] || die "pstack source is missing: $name"
	done
	rm -f "$DISABLED"
fi

for skill_root in "${ROOTS[@]}"; do
	for name in pstack "${NAMES[@]}"; do
		target="$skill_root/$name"
		if [ "$action" = on ] && [ "$name" != pstack ]; then
			mkdir -p "$skill_root"
			if [ "$(cd "$target" 2>/dev/null && pwd -P)" = "$(cd "$source_root/$name" && pwd -P)" ]; then
				continue
			fi
			[ ! -L "$target" ] || rm -f "$target"
			ln -s "$source_root/$name" "$target"
		elif managed_target "$target" "$name"; then
			rm -f "$target"
		fi
	done
done
printf 'pstack: %s; content and unrelated skills preserved\n' "$action"
