#!/usr/bin/env bash
# Read what changed across every checkout and worktree on this machine.
#
# git-fleet-status answers "what changed anywhere". This answers the only
# question that ever follows it: show me. With no arguments it opens a picker of
# every changed *file* across every checkout, with that one file's diff beside
# it, and every key returns to the list, so reading a whole fleet is arrow keys
# and Enter and nothing else.
#
# One file is the unit on purpose. A worktree's whole diff can be thousands of
# lines, and a scroll-only preview pane is the wrong shape for it; a file is
# something the eye can take in, and typing filters across repository and
# filename at once, so "every .nix that changed anywhere" is four keystrokes.
# --repos keeps the coarser view for "what is this worktree doing overall".
#
# Agents work in detached-HEAD worktrees under a treehouse root, and neither
# obvious command works there: a bare `git diff` shows only the uncommitted tail
# of their work, and `git diff main` invents deletions for every commit the base
# branch gained meanwhile. So each diff is taken two-dot from the merge base with
# the checkout's own base branch - the comparison a pull request shows - which
# folds committed, staged and unstaged work into one stream, with whole new files
# appended.
#
# Read-only, like the scanner: nothing is staged and no index is written.
# Untracked files render through `git diff --no-index` rather than the usual
# `git add -N` trick, which would write to the index of a repository an agent is
# still working in.

set -uo pipefail

export GIT_OPTIONAL_LOCKS=0
export GIT_TERMINAL_PROMPT=0

PROG=${0##*/}
# Absolute, because fzf's preview and its key bindings run this script again by
# name from a shell whose PATH is not guaranteed to be this one.
SELF=$(cd -- "$(dirname -- "$0")" && pwd -P)/$(basename -- "$0")

note() {
	printf '%s: %s\n' "$PROG" "$1" >&2
}

die() {
	note "$1"
	exit 2
}

usage() {
	cat <<'EOF'
Usage: git-fleet-diff [options] [path...]

With no path, opens a picker of every changed file across every checkout and
worktree, with that file's diff alongside. Each diff is measured against the
checkout's own base branch, so it covers commits that branch has not seen plus
staged, unstaged and untracked work.

  enter             read this file's diff, full screen
  ctrl-r            the whole checkout's diff, full screen
  ctrl-g            open the checkout in lazygit
  ctrl-e            open the file in $EDITOR
  ctrl-d / ctrl-u   scroll the diff
  ctrl-/            cycle preview size
  esc               done

Every key comes back to the list, so nothing is a dead end.

Options:
  -R, --repos       pick a whole checkout instead of a file
  -a, --all         print every changed checkout's diff as one stream
  -s, --stat        summarise as changed files and counts, without contents
  -r, --root DIR    search root, repeatable; passed to git-fleet-status
  -d, --depth N     maximum search depth; passed to git-fleet-status
  -h, --help        this message

A path may be any directory inside a checkout. Rendering is delta's, configured
once in home/.config/git/pretty-diff.gitconfig, so this looks like every other
diff on the machine.

One page in a browser instead, for reading over a lot of work at once:

  fleet-html                  every changed checkout, each diff one click away
  fleet-html --host DESK      that machine's fleet, in this machine's browser
  fleet-html -2               diffs side by side, old on the left, new on the right
  fleet-html ~/some/checkout  just this one

  -w, --html        write the page (implied by the fleet-html name)
  -2, --side-by-side  render the diffs in two columns
  -o, --output FILE   write it here instead of the default cache path
      --stdout        write it to stdout, and open nothing
  -H, --host HOST     render HOST's fleet over ssh and open it here

The page is one self-contained file with no server behind it and nothing loaded
from the network, which is what makes --host a plain ssh pipe rather than a
forwarded port. It is a snapshot: rerun for a newer one.
EOF
}

MODE=files
STAT=0
PAGE=1
SIDE=0
OUTPUT=
HOST=
SCAN_ARGS=()
PATHS=()

# Installed under a second name as well, because "the browser one" is a different
# thing to reach for than "the picker one" and remembering a flag is one more step
# between wondering what the agents did and seeing it.
case $PROG in
fleet-html | git-fleet-html) MODE=html ;;
esac

while [ $# -gt 0 ]; do
	case $1 in
	-R | --repos) MODE=repos ;;
	-a | --all) MODE=all ;;
	-s | --stat) STAT=1 ;;
	-w | --html) MODE=html ;;
	-2 | --side-by-side) SIDE=1 ;;
	--stdout)
		MODE=html
		OUTPUT=-
		;;
	-o | --output)
		MODE=html
		shift
		[ $# -gt 0 ] || die '--output needs a file'
		OUTPUT=$1
		;;
	-H | --host)
		MODE=html
		shift
		[ $# -gt 0 ] || die '--host needs a machine to ask'
		HOST=$1
		;;
	# --print renders into a preview pane, --show onto a real screen. Both take a
	# checkout and optionally one file inside it; they are how the picker calls
	# back into this script, and are equally usable by hand.
	-p | --print)
		MODE=print
		PAGE=0
		;;
	--show)
		MODE=show
		PAGE=1
		;;
	-r | --root | -d | --depth)
		flag=$1
		shift
		[ $# -gt 0 ] || die "$flag needs a value"
		SCAN_ARGS+=("$flag" "$1")
		;;
	-h | --help)
		usage
		exit 0
		;;
	-*) die "unknown option: $1" ;;
	*) PATHS+=("$1") ;;
	esac
	shift
done

# Reading is not looking away. Every scan the scanner performs saves a new baseline,
# which is what lets the next one open with what changed while you were gone - so a
# scan run to show something else has to leave that baseline alone, or opening one
# diff quietly answers and discards the question "what happened overnight".
SCAN_ARGS+=(--no-save)

# --stat asks for a summary "without contents", which is a thing to read, not a
# thing to browse. On its own it used to leave MODE at its interactive default and
# open the picker, so `git-fleet-diff -s` with no terminal - a pipe, a script, an
# agent - blocked forever on an fzf waiting for a tty that was never coming, with
# nothing on stdout to suggest why. An explicit mode still wins, so `-R -s` and
# `-a -s` keep summarising inside the mode they name.
if [ "$STAT" -eq 1 ] && [ "$MODE" = files ]; then
	MODE=all
fi

case $MODE in
print | show)
	case ${#PATHS[@]} in
	1 | 2) ;;
	*) die "$MODE takes a checkout and optionally one file inside it" ;;
	esac
	;;
files)
	[ ${#PATHS[@]} -gt 0 ] && MODE=paths
	;;
esac

DELTA=$(command -v delta 2>/dev/null) || DELTA=
# delta wants the diff uncoloured so it can colour it itself; without delta,
# git's own colours through a pager are still perfectly readable.
if [ -n "$DELTA" ]; then
	DIFF_COLOR=--no-color
else
	DIFF_COLOR=--color=always
fi

DIFF_OPTS=("$DIFF_COLOR")
[ "$STAT" -eq 1 ] && DIFF_OPTS+=(--stat)

# ------------------------------------------------------------------ rendering

# Width drives two decisions, so it is measured once. Inside fzf the preview pane
# is narrower than the terminal and only fzf knows by how much.
term_width() {
	local w=${FZF_PREVIEW_COLUMNS:-}
	[ -n "$w" ] || w=$(tput cols 2>/dev/null) || w=
	case ${w:-} in
	'' | *[!0-9]*) printf '0\n' ;;
	*) printf '%s\n' "$w" ;;
	esac
}

render() {
	local width args=()
	width=$(term_width)

	if [ -z "$DELTA" ]; then
		if [ "$PAGE" -eq 1 ] && [ -t 1 ]; then less -R; else cat; fi
		return
	fi

	# Side-by-side only once there is room for two readable columns. Below that it
	# wraps every line into noise, and 80 columns is what an ssh window opens at.
	[ "$width" -ge 160 ] && args+=(--side-by-side)
	[ "$width" -gt 0 ] && args+=(--width "$width")
	if [ "$PAGE" -eq 0 ]; then
		# In a preview pane stdout is a pipe, which is normally delta's cue to drop
		# colour; fzf renders the ANSI itself, so force it.
		args+=(--paging=never)
		CLICOLOR_FORCE=1 "$DELTA" "${args[@]+"${args[@]}"}"
		return
	fi
	"$DELTA" "${args[@]+"${args[@]}"}"
}

# -------------------------------------------------------------- one checkout

# Best local base to measure a checkout's contribution against, without any
# network call. Mirrors git-fleet-status's own base_ref preference order so the
# scan's "unique commits" column and this diff describe the same range;
# tests/git-fleet-diff.test.sh asserts the two agree.
base_ref() {
	git -C "$1" for-each-ref --format='%(refname)' \
		refs/remotes/origin/HEAD refs/remotes/origin/main refs/remotes/origin/master \
		refs/heads/main refs/heads/master 2>/dev/null |
		awk '
    { seen[$0] = 1 }
    END {
      n = split("refs/remotes/origin/HEAD refs/remotes/origin/main " \
                "refs/remotes/origin/master refs/heads/main refs/heads/master", p, " ")
      for (i = 1; i <= n; i++) if (p[i] in seen) { print p[i]; exit }
    }
  '
}

# The single revision every tracked diff here is taken against. Fails, rather
# than defaulting, when there are no commits at all, because then there is no
# tracked side to show. A checkout with commits but no base branch to compare
# against still has an honest answer: its working tree against its own HEAD.
range_of() {
	local repo=$1 head base merge_base
	head=$(git -C "$repo" rev-parse -q --verify HEAD 2>/dev/null) || return 1
	[ -n "$head" ] || return 1
	base=$(base_ref "$repo")
	merge_base=
	[ -n "$base" ] &&
		{ merge_base=$(git -C "$repo" merge-base "$base" HEAD 2>/dev/null) || merge_base=; }
	printf '%s\n' "${merge_base:-HEAD}"
}

toplevel() {
	git -C "$1" rev-parse --show-toplevel 2>/dev/null
}

HOME_PHYS=$(cd -- "$HOME" 2>/dev/null && pwd -P) || HOME_PHYS=$HOME

# shellcheck disable=SC2088 # display text, never a path to expand
abbrev() {
	case $1 in
	"$HOME"/*) printf '~/%s\n' "${1#"$HOME"/}" ;;
	"$HOME_PHYS"/*) printf '~/%s\n' "${1#"$HOME_PHYS"/}" ;;
	*) printf '%s\n' "$1" ;;
	esac
}

# Whole new files, as new-file diffs, without touching the index.
#
# --no-index implies --exit-code, so every file it prints "fails" with status 1.
# Under pipefail that would make the whole stream look like an error, hence the
# explicit success: printing a diff is this function succeeding.
untracked_body() {
	local repo=$1 file
	while IFS= read -r -d '' file; do
		# A directory symlink or a file deleted since the scan makes this fail; that
		# is a stale entry, not something to report, so it is dropped.
		git -C "$repo" diff --no-index "${DIFF_OPTS[@]}" -- /dev/null "$file" 2>/dev/null
	done < <(git -C "$repo" ls-files -o --exclude-standard -z 2>/dev/null)
	return 0
}

diff_body() {
	local repo=$1 range
	range=$(range_of "$repo") && git -C "$repo" diff "${DIFF_OPTS[@]}" "$range" 2>/dev/null
	untracked_body "$repo"
}

# One file, from whichever side it lives on. The index decides: a path git knows
# about diffs against the range even when the working tree no longer has it,
# which is what shows a deletion; anything else is new and has no other side to
# compare against than nothing.
file_body() {
	local repo=$1 file=$2 range
	if git -C "$repo" ls-files --error-unmatch -- "$file" >/dev/null 2>&1; then
		range=$(range_of "$repo") &&
			git -C "$repo" diff "${DIFF_OPTS[@]}" "$range" -- "$file" 2>/dev/null
	else
		git -C "$repo" diff --no-index "${DIFF_OPTS[@]}" -- /dev/null "$file" 2>/dev/null
	fi
	return 0
}

branch_of() {
	local repo=$1 branch
	branch=$(git -C "$repo" symbolic-ref -q --short HEAD 2>/dev/null) ||
		branch="detached $(git -C "$repo" rev-parse -q --short HEAD 2>/dev/null)"
	printf '%s\n' "${branch:-no commits}"
}

# The stream concatenates many checkouts and delta has no idea where one ends, so
# each gets a banner. Box-drawing on purpose: a line starting with - or + inside
# a diff stream means something else.
banner() {
	printf '\n──────── %s  [%s]\n\n' "$(abbrev "$1")" "$(branch_of "$1")"
}

# Above a single file's diff, where the rule would be noise in a narrow pane. The
# picker row already carries the path; the branch is the part that says whose work
# this is, which is the whole question when seven worktrees hold the same file.
#
# No trailing blank line: delta opens its own output with one, and two of the
# thirty lines a preview pane has are too many to spend on nothing.
context() {
	printf '%s  [%s]\n' "$(abbrev "$1")" "$(branch_of "$1")"
}

# ------------------------------------------------------------------- scanning

resolve_scanner() {
	local candidate
	for candidate in \
		"${GIT_FLEET_STATUS:-}" \
		"$(command -v git-fleet-status 2>/dev/null)" \
		"$HOME/.dotfiles/scripts/git-fleet-status" \
		"$HOME/mac-setup/scripts/git-fleet-status"; do
		[ -n "$candidate" ] && [ -x "$candidate" ] && {
			printf '%s\n' "$candidate"
			return 0
		}
	done
	return 1
}

SCANNER=$(resolve_scanner) ||
	die 'git-fleet-status not found; set GIT_FLEET_STATUS or install the dotfiles'

require_jq() {
	command -v jq >/dev/null 2>&1 ||
		die 'jq is required; run scripts/install-diff-tools'
}

# path<TAB>row per changed checkout, reusing the row the scanner already rendered
# so the picker and the `fleet` table read identically rather than merely alike.
scan_rows() {
	require_jq
	"$SCANNER" --json "${SCAN_ARGS[@]+"${SCAN_ARGS[@]}"}" |
		jq -r 'select(.type == "repo") | [.path, .row] | @tsv'
}

scan_paths() {
	"$SCANNER" --paths "${SCAN_ARGS[@]+"${SCAN_ARGS[@]}"}"
}

stream() {
	local repo top
	for repo in "$@"; do
		top=$(toplevel "$repo") || top=
		[ -n "$top" ] || {
			note "not a git checkout: $repo"
			continue
		}
		banner "$top"
		diff_body "$top"
	done
}

stream_all() {
	local -a repos=()
	while IFS= read -r repo; do
		[ -n "$repo" ] && repos+=("$repo")
	done < <(scan_paths)
	[ ${#repos[@]} -gt 0 ] || {
		printf 'Nothing changed anywhere.\n'
		return 0
	}
	stream "${repos[@]}"
}

# ---------------------------------------------------------------- file rows

# checkout<TAB>file<TAB>status<TAB>label, one line per changed file anywhere.
#
# Renames arrive from --name-status as status, old, new; the new name is the one
# worth showing and the only one a later `git diff -- <path>` accepts. Untracked
# files are marked ? rather than A, because git has not been told about them and
# the distinction is the difference between reviewed and merely present.
file_rows() {
	local repo top label range status old new path
	while IFS= read -r repo; do
		[ -n "$repo" ] || continue
		top=$(toplevel "$repo") || continue
		[ -n "$top" ] || continue
		label=$(abbrev "$top")

		if range=$(range_of "$top"); then
			while IFS=$'\t' read -r status old new; do
				[ -n "${status:-}" ] || continue
				path=${new:-$old}
				printf '%s\t%s\t%s\t%s\n' "$top" "$path" "${status:0:1}" "$label"
			done < <(git -C "$top" diff --name-status "$range" 2>/dev/null)
		fi

		while IFS= read -r -d '' path; do
			# git reports a nested checkout as its directory, with a trailing slash.
			# Its contents belong to that repository, which the scan lists in its own
			# right when it is in scope, and there is no single file here to diff - so
			# the row would render an empty pane. Drop it rather than show a dead end.
			case $path in */) continue ;; esac
			printf '%s\t%s\t?\t%s\n' "$top" "$path" "$label"
		done < <(git -C "$top" ls-files -o --exclude-standard -z 2>/dev/null)
	done < <(scan_paths)
}

# status, checkout and file as three aligned columns, with the two hidden fields
# fzf needs kept in front. The checkout column is padded to the widest label so
# filenames line up down the page, capped so one deep worktree path cannot push
# every filename off screen; a capped label keeps its tail, which is the part
# that identifies it.
#
# Padding counts bytes, so the multi-byte ellipsis is paid for explicitly. Every
# other character in a path here is ASCII, where bytes and columns agree.
format_rows() {
	awk -F'\t' '
    { rows[NR] = $0; if (length($4) > width) width = length($4) }
    END {
      cap = 30
      if (width > cap) width = cap
      colour["M"] = "\033[33m"; colour["A"] = "\033[32m"; colour["?"] = "\033[32m"
      colour["D"] = "\033[31m"; colour["R"] = "\033[36m"; colour["C"] = "\033[36m"
      for (i = 1; i <= NR; i++) {
        n = split(rows[i], f, "\t")
        if (n < 4) continue
        label = f[4]
        pad = width
        if (length(label) > width) {
          label = "…" substr(label, length(label) - width + 2)
          pad = width + 2
        }
        c = (f[3] in colour) ? colour[f[3]] : ""
        printf "%s\t%s\t%s%s\033[0m  \033[2m%s\033[0m  %s\n", \
          f[1], f[2], c, f[3], sprintf("%-" pad "s", label), f[2]
      }
    }
  '
}

# --------------------------------------------------------------------- picker

have() {
	command -v "$1" >/dev/null 2>&1
}

# Actions are execute() bindings rather than --expect, so reading a diff returns
# to the list instead of ending the session. Browsing a fleet is the point; every
# key being a dead end was the thing that made it feel like work.
file_picker() {
	local rows binds=()

	if ! have fzf; then
		note 'fzf is not installed; showing every changed checkout instead'
		stream_all | render
		return
	fi

	# The column width comes from the widest label, so the rows are collected before
	# any of them can be shown. That is a few seconds across a whole fleet, and a
	# terminal that says nothing for a few seconds reads as a hang.
	note 'scanning every checkout…'
	rows=$(file_rows | format_rows)
	[ -n "$rows" ] || {
		printf 'Nothing changed anywhere.\n'
		return 0
	}

	binds+=("enter:execute($SELF --show {1} {2})")
	binds+=("ctrl-r:execute($SELF --show {1})")
	binds+=("ctrl-e:execute(cd -- {1} && ${EDITOR:-nvim} -- {2})")
	binds+=('ctrl-d:preview-half-page-down' 'ctrl-u:preview-half-page-up')
	binds+=('ctrl-/:change-preview-window(right,80%|down,75%|right,60%)')
	have lazygit && binds+=("ctrl-g:execute(lazygit --path {1})")

	printf '%s\n' "$rows" |
		fzf --ansi --layout=reverse --border --cycle --info=inline --scroll-off=3 \
			--delimiter=$'\t' --with-nth=3 \
			--preview="$SELF --print {1} {2}" \
			--preview-window='right,60%,border-left' \
			--header='enter read · ctrl-r whole repo · ctrl-g lazygit · ctrl-e edit · ctrl-d/u scroll' \
			"${binds[@]/#/--bind=}" >/dev/null
	return 0
}

repo_picker() {
	local rows binds=()

	if ! have fzf; then
		note 'fzf is not installed; showing every changed checkout instead'
		stream_all | render
		return
	fi

	rows=$(scan_rows) || return 1
	[ -n "$rows" ] || {
		printf 'Nothing changed anywhere.\n'
		return 0
	}

	binds+=("enter:execute($SELF --show {1})")
	binds+=("ctrl-e:execute(cd -- {1} && ${EDITOR:-nvim} .)")
	binds+=('ctrl-d:preview-half-page-down' 'ctrl-u:preview-half-page-up')
	binds+=('ctrl-/:change-preview-window(right,80%|down,75%|right,62%)')
	have lazygit && binds+=("ctrl-g:execute(lazygit --path {1})")

	printf '%s\n' "$rows" |
		fzf --ansi --no-sort --layout=reverse --border --cycle --info=inline \
			--delimiter=$'\t' --with-nth=2 \
			--preview="$SELF --print {1}" \
			--preview-window='right,62%,border-left' \
			--header='enter full diff · ctrl-g lazygit · ctrl-e editor · ctrl-d/u scroll' \
			"${binds[@]/#/--bind=}" >/dev/null
	return 0
}

# --------------------------------------------------------------- html report
#
# The terminal answers "show me this one file" well and "let me look over
# everything a dozen agents did" badly: a pager holds one diff at a time and an
# fzf preview pane is thirty lines tall. A browser is the right shape for the
# second question - every checkout on one page, each one folded shut until you
# want it, ordinary scrolling, ordinary find-in-page - so this renders the same
# rows `fleet` prints, with each row's whole diff hidden underneath it.
#
# One self-contained file: no server, no port to forward, no network at load time.
# delta already renders every diff on this machine, so its own output is converted
# to HTML rather than a second renderer being installed to disagree with it. That
# is also what makes reading a dev desk's fleet from the Mac a single ssh pipe -
# the file arrives whole, over the connection that is already open.

# How much diff the page carries, per row and in total. The total is what decides
# whether the page opens at all: a coloured diff line costs about 400 bytes of
# markup, so the dev desk's 79 changed checkouts at 4000 lines each rendered a 92MB
# file - and nearly all of it was diff nobody clicked. The budget is shared out
# across however many checkouts changed, so five of them get their whole diff and
# eighty get a readable head each, with every truncated row ending in the command
# that shows all of it. Set GIT_FLEET_HTML_MAX_LINES to pin a per-row cap and ignore
# the budget entirely.
HTML_BUDGET_LINES=${GIT_FLEET_HTML_BUDGET:-20000}
HTML_MAX_LINES=${GIT_FLEET_HTML_MAX_LINES:-4000}
HTML_MIN_LINES=200
HTML_WIDTH=176

# Called once the scan is in, because the share depends on how many rows there are.
html_fit_budget() {
	local rows=$1 share
	[ -z "${GIT_FLEET_HTML_MAX_LINES:-}" ] || return 0
	[ "$rows" -gt 0 ] || return 0
	share=$((HTML_BUDGET_LINES / rows))
	[ "$share" -lt "$HTML_MIN_LINES" ] && share=$HTML_MIN_LINES
	[ "$share" -lt "$HTML_MAX_LINES" ] && HTML_MAX_LINES=$share
	return 0
}

esc_html() {
	local s=$1
	s=${s//&/&amp;}
	s=${s//</&lt;}
	s=${s//>/&gt;}
	s=${s//\"/&quot;}
	printf '%s' "$s"
}

# delta's colours, as HTML.
#
# Every diff on this machine is already delta's, and the page has to look like the
# terminal rather than like a different tool, so what is converted is delta's ANSI
# rather than git's plain patch. Handles the escapes delta actually emits: 24-bit
# and 256-colour foreground and background, the eight basic pairs, bold, dim,
# italic, underline and reverse. Cursor movement and OSC hyperlinks are dropped -
# they mean nothing on a page.
ansi_to_html() {
	awk -v repo="$1" -v maxlines="$HTML_MAX_LINES" '
    function esc(s) {
      gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s)
      return s
    }
    function rgb(r, g, b) { return sprintf("#%02x%02x%02x", r, g, b) }
    function xterm(v,   c) {
      if (v < 16) return basic[v]
      if (v > 231) { c = 8 + (v - 232) * 10; return rgb(c, c, c) }
      v -= 16
      return rgb(cube[int(v / 36) % 6 + 1], cube[int(v / 6) % 6 + 1], cube[v % 6 + 1])
    }
    function reset() { fg = ""; bg = ""; bold = 0; dim = 0; ital = 0; und = 0; rev = 0 }
    function style(   s, f, b, t) {
      s = ""; f = fg; b = bg
      # Reverse video is a swap, and delta uses it for the file header, so a
      # missing side has to fall back to the page colour or the text vanishes.
      if (rev) { t = f; f = (b == "" ? "#0d1117" : b); b = (t == "" ? "#c9d1d9" : t) }
      if (f != "") s = s "color:" f ";"
      if (b != "") s = s "background:" b ";"
      if (bold) s = s "font-weight:600;"
      if (dim) s = s "opacity:.6;"
      if (ital) s = s "font-style:italic;"
      if (und) s = s "text-decoration:underline;"
      return s
    }
    function sgr(params,   n, p, j, v, c) {
      if (params == "") { reset(); return }
      n = split(params, p, ";")
      for (j = 1; j <= n; j++) {
        v = p[j] + 0
        if (v == 0) reset()
        else if (v == 1) bold = 1
        else if (v == 2) dim = 1
        else if (v == 3) ital = 1
        else if (v == 4) und = 1
        else if (v == 7) rev = 1
        else if (v == 22) { bold = 0; dim = 0 }
        else if (v == 23) ital = 0
        else if (v == 24) und = 0
        else if (v == 27) rev = 0
        else if (v == 39) fg = ""
        else if (v == 49) bg = ""
        else if (v >= 30 && v <= 37) fg = basic[v - 30]
        else if (v >= 40 && v <= 47) bg = basic[v - 40]
        else if (v >= 90 && v <= 97) fg = basic[v - 82]
        else if (v >= 100 && v <= 107) bg = basic[v - 92]
        else if (v == 38 || v == 48) {
          # 38;2;r;g;b or 38;5;n, and the parameters belong to this code alone.
          if (p[j + 1] + 0 == 2) { c = rgb(p[j + 2] + 0, p[j + 3] + 0, p[j + 4] + 0); j += 4 }
          else if (p[j + 1] + 0 == 5) { c = xterm(p[j + 2] + 0); j += 2 }
          else continue
          if (v == 38) fg = c; else bg = c
        }
      }
    }
    BEGIN {
      ESC = sprintf("%c", 27); BEL = sprintf("%c", 7)
      split("#484f58 #ff7b72 #7ee787 #e3b341 #79c0ff #d2a8ff #56d4dd #b1bac4 " \
            "#6e7681 #ffa198 #56d364 #f0d478 #a5d6ff #e2c5ff #76e3ea #f0f6fc", pal, " ")
      for (k = 0; k < 16; k++) basic[k] = pal[k + 1]
      split("0 95 135 175 215 255", cube, " ")
      reset()
    }
    {
      if (count >= maxlines) { cut++; next }
      count++
      line = $0
      gsub(/\r/, "", line)
      gsub(ESC "\\][^" BEL ESC "]*(" BEL "|" ESC "\\\\)", "", line)
      # Colour carries across a line break in a terminal, so the span is reopened
      # at the start of every line rather than left dangling across one.
      st = style()
      if (st != "") { out = "<span style=\"" st "\">"; open = 1 } else { out = ""; open = 0 }
      n = split(line, seg, ESC "\\[")
      out = out esc(seg[1])
      for (k = 2; k <= n; k++) {
        s = seg[k]
        if (match(s, /^[0-9;:]*[@-~]/)) {
          code = substr(s, RSTART, RLENGTH)
          term = substr(code, RLENGTH, 1)
          rest = substr(s, RSTART + RLENGTH)
          if (term == "m") {
            sgr(substr(code, 1, RLENGTH - 1))
            if (open) { out = out "</span>"; open = 0 }
            st = style()
            if (st != "") { out = out "<span style=\"" st "\">"; open = 1 }
          }
          out = out esc(rest)
        } else {
          out = out esc(s)
        }
      }
      if (open) { out = out "</span>"; open = 0 }
      print out
    }
    END {
      if (cut > 0)
        printf "\n<span class=\"cut\">.. and %d more lines. Read all of it with:  " \
               "fleet-diff %s</span>\n", cut, esc(repo)
    }
  '
}

html_body() {
	local repo=$1
	local -a args=(--paging=never --true-color=always --width "$HTML_WIDTH")
	[ "$SIDE" -eq 1 ] && args+=(--side-by-side)
	if [ -n "$DELTA" ]; then
		diff_body "$repo" | CLICOLOR_FORCE=1 "$DELTA" "${args[@]}" 2>/dev/null |
			ansi_to_html "$(abbrev "$repo")"
	else
		diff_body "$repo" | ansi_to_html "$(abbrev "$repo")"
	fi
}

html_style() {
	cat <<'CSS'
:root { color-scheme: dark }
* { box-sizing: border-box }
body {
  margin: 0; padding: 2.2rem 2.4rem 6rem;
  background: #0d1117; color: #c9d1d9;
  font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
}
a { color: #79c0ff; text-decoration: none }
a:hover { text-decoration: underline }
h1 { margin: 0; font-size: 1.05rem; font-weight: 600 }
h1 .dim { color: #6e7681; font-weight: 400 }
.sub { margin: .35rem 0 1.5rem; color: #8b949e; font-size: 13px }
h2 { margin: 2.2rem 0 .5rem; font-size: .72rem; font-weight: 600;
     letter-spacing: .14em; text-transform: uppercase; color: #8b949e }
h2 .count { color: #6e7681; font-weight: 400; letter-spacing: .05em }
.bar { display: flex; gap: .5rem }
button { font: inherit; font-size: 12px; color: #c9d1d9; background: #21262d;
         border: 1px solid #30363d; border-radius: 6px; padding: .2rem .65rem; cursor: pointer }
button:hover { background: #30363d }
.journal { font-size: 13px; border-left: 2px solid #21262d; padding-left: .95rem }
/* Columns, not padded inline blocks: one long worktree name would otherwise push
   its own detail out of line with every other row's. */
.journal div {
  display: grid; align-items: baseline; gap: 0 1rem; padding: .1rem 0;
  grid-template-columns: 4.5rem minmax(12rem, 24rem) 1fr;
}
.journal .verb { color: #7ee787 }
/* The journal names the same checkouts, so it truncates them the same way. Both
   colours are restated because .nm sets one of its own, and only the row that has
   somewhere to jump to may look like a link. */
.journal .name { font-weight: 400 }
.journal a.name { color: #79c0ff }
.journal span.name { color: #c9d1d9 }
.journal .changed { color: #e3b341 }
.journal .gone { color: #6e7681 }
.journal .detail { color: #8b949e }
.row { border-top: 1px solid #161b22 }
.rows .row:last-child { border-bottom: 1px solid #161b22 }
/* Every track is a fixed length or a fraction, none of them content-sized, so the
   columns land in the same place on every row. An auto-sized last column is the
   subtle version of this bug: +9/-3 and +1485/-13447 size their own track, and
   then no two rows' line counts line up. */
/* The name takes the slack, because it is the only column with no honest upper
   bound: a Brazil workspace path is sixty characters. The three beside it are sized
   to what a real fleet holds, measured rather than guessed - a branch runs to
   thirty-six characters and a "what" to thirty-five ("19 commits to push, 1 edited,
   7 new"), and both are told apart by their ends, so a column too narrow for them
   is worse than one that leaves a gap. Shown at twelve rems,
   fm/fm-pi-adapter-records-w4 and fm/fm-pi-adapter-recover-w4 read alike. */
.row > summary {
  display: grid; align-items: baseline; gap: 0 1.1rem; cursor: pointer;
  grid-template-columns: 1rem minmax(14rem, 1fr) minmax(8rem, 20rem) 16rem 8rem;
  padding: .4rem .5rem; border-radius: 5px; list-style: none;
}
.row > summary::-webkit-details-marker { display: none }
.row > summary::before { content: "\25b8"; color: #6e7681; font-size: .78em }
.row[open] > summary::before { content: "\25be" }
.row > summary:hover, .row[open] > summary { background: #161b22 }
/* html_name() has already elided the label from the left, at a character count.
   This is the backstop for a proportional font making 54 characters wider than the
   column: it clips rather than pushing the branch out of line. */
.nm, .br { overflow: hidden; text-overflow: ellipsis; white-space: nowrap }
.nm { color: #e6edf3; font-weight: 500 }
.br { color: #d2a8ff }
.sz {
  color: #8b949e; white-space: nowrap; text-align: right;
  font-variant-numeric: tabular-nums;
}
pre { margin: 0; padding: .75rem .9rem 1rem; overflow-x: auto;
      background: #010409; border-top: 1px solid #161b22;
      font: 12px/1.45 ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace }
.cut { color: #e3b341 }
.none { color: #8b949e; font-size: 13px }
footer { margin-top: 3.2rem; color: #6e7681; font-size: 12px; line-height: 1.8 }
code { background: #161b22; border-radius: 4px; padding: .1rem .35rem;
       font: 12px ui-monospace, SFMono-Regular, Menlo, monospace }
CSS
}

html_script() {
	cat <<'JS'
(function () {
  function reveal() {
    var id = location.hash.slice(1);
    var el = id ? document.getElementById(id) : null;
    if (el && el.tagName === 'DETAILS') {
      el.open = true;
      el.scrollIntoView({ block: 'center' });
    }
  }
  addEventListener('hashchange', reveal);
  reveal();
  var buttons = document.querySelectorAll('button[data-all]');
  for (var i = 0; i < buttons.length; i++) {
    buttons[i].addEventListener('click', function () {
      var want = this.getAttribute('data-all') === 'open';
      var rows = document.querySelectorAll('details.row');
      for (var j = 0; j < rows.length; j++) rows[j].open = want;
    });
  }
})();
JS
}

# The scan, taken apart into parallel arrays. Deliberately not local: the section
# printers below read them, and one report is rendered per run.
H_PATH=()
H_KIND=()
H_NAME=()
H_BRANCH=()
H_WHAT=()
H_SIZE=()

# Every row of one section, each one a fold holding its own diff. Rendering the
# diff inside the row rather than on a separate page is the whole reason this is
# nicer than the terminal: the list stays put and the answer opens under the
# question, so reading twenty checkouts never loses the reader's place.
html_section() {
	local want=$1 title=$2 total=0 i=0
	while [ "$i" -lt ${#H_PATH[@]} ]; do
		[ "${H_KIND[$i]}" = "$want" ] && total=$((total + 1))
		i=$((i + 1))
	done
	[ "$total" -gt 0 ] || return 0

	printf '<h2>%s <span class="count">(%d)</span></h2>\n' "$(esc_html "$title")" "$total"
	# Wrapped, so each section's list closes with its own rule. Without it the
	# rule belongs to the last row on the page and one section ends mid-air.
	printf '<div class="rows">\n'
	i=0
	while [ "$i" -lt ${#H_PATH[@]} ]; do
		if [ "${H_KIND[$i]}" = "$want" ]; then
			note "rendering ${H_NAME[$i]}"
			printf '<details class="row" id="d%d"><summary><span class="nm" title="%s">%s</span>' \
				"$i" "$(esc_html "${H_PATH[$i]}")" "$(html_name "${H_NAME[$i]}")"
			# The branch carries a title for the same reason the name does: the column
			# holds about twenty-four characters and a long fm/ branch is told apart by
			# its last few.
			printf '<span class="br" title="%s">%s</span><span class="wh">%s</span><span class="sz">%s</span>' \
				"$(esc_html "${H_BRANCH[$i]}")" "$(esc_html "${H_BRANCH[$i]}")" \
				"$(esc_html "${H_WHAT[$i]}")" \
				"$(esc_html "${H_SIZE[$i]}")"
			printf '</summary><pre>'
			html_body "${H_PATH[$i]}"
			printf '</pre></details>\n'
		fi
		i=$((i + 1))
	done
	printf '</div>\n'
	return 0
}

# The label as the column can hold it, elided from the left - the same decision the
# terminal table makes, for the same reason. Rows in a fleet share their leading
# directories, and this desk's dominant shape is a Brazil workspace: six rows read
# `~/lineage-ws-lineage-cr2-…/src/AWSGlueLineageAppConfigCDK`, identical in both the
# first characters and the last, and told apart only by the end of the workspace
# name in the middle. Keeping the end keeps that. The whole path stays on the row's
# title attribute, so hovering answers anything this drops.
HTML_LABEL_CAP=54

html_name() {
	local label=$1
	[ ${#label} -le "$HTML_LABEL_CAP" ] || label="…${label: -$((HTML_LABEL_CAP - 1))}"
	esc_html "$label"
}

# The anchor of a checkout's row, so a journal entry can jump straight to it. A
# checkout that went clean has no row to jump to, which is why this can fail.
html_anchor() {
	local want=$1 i=0
	while [ "$i" -lt ${#H_PATH[@]} ]; do
		[ "${H_PATH[$i]}" = "$want" ] && {
			printf 'd%d\n' "$i"
			return 0
		}
		i=$((i + 1))
	done
	return 1
}

html_report() {
	local snapshot host now has_previous previous_at total_lines
	local path kind name branch what size verb detail anchor
	local -a scan=(${SCAN_ARGS[@]+"${SCAN_ARGS[@]}"})

	require_jq
	host=$(hostname -f 2>/dev/null) || host=
	[ -n "$host" ] || host=$(uname -n 2>/dev/null) || host=this machine
	now=$(date '+%Y-%m-%d %H:%M %Z')

	# A path names one checkout to report on. Resolving it to its toplevel first is
	# what lets it be any directory inside one, and handing it to the scanner as a
	# root keeps every row's wording identical to a whole-fleet report.
	if [ ${#PATHS[@]} -gt 0 ]; then
		local given top
		for given in "${PATHS[@]}"; do
			top=$(toplevel "$given") || top=
			[ -n "$top" ] || die "not a git checkout: $given"
			scan+=(--root "$top")
		done
		scan+=(--depth 1)
	fi

	snapshot=$(mktemp "${TMPDIR:-/tmp}/git-fleet-html.XXXXXX") ||
		die 'cannot create a temporary file'
	note 'scanning every checkout…'
	"$SCANNER" --json "${scan[@]}" >"$snapshot" || {
		rm -f "$snapshot"
		die 'the scan failed'
	}

	while IFS=$'\t' read -r path kind name branch what size; do
		[ -n "$path" ] || continue
		# The branch as the table says it, not as git spells it: an agent worktree is
		# on a detached HEAD, and "(c70f8c2)" in this column is a hash where a name
		# belongs.
		H_PATH+=("$path")
		H_KIND+=("$kind")
		H_NAME+=("$name")
		H_BRANCH+=("$branch")
		H_WHAT+=("$what")
		H_SIZE+=("$size")
	done < <(jq -r 'select(.type == "repo")
		| [.path, .kind, .name, .branchLabel, .what, .lines] | @tsv' "$snapshot")

	html_fit_budget "${#H_PATH[@]}"

	has_previous=$(jq -r 'select(.type == "meta") | .hasPrevious' "$snapshot")
	previous_at=$(jq -r 'select(.type == "meta") | .previousAt' "$snapshot")
	total_lines=$(jq -rs 'map(select(.type == "repo"))
		| "+\(map(.added) | add // 0)/-\(map(.deleted) | add // 0)"' "$snapshot")

	printf '<!doctype html>\n<html lang="en"><head><meta charset="utf-8">\n'
	printf '<meta name="viewport" content="width=device-width,initial-scale=1">\n'
	printf '<title>fleet - %s</title>\n<style>\n' "$(esc_html "$host")"
	html_style
	printf '</style></head><body>\n'
	printf '<h1>fleet <span class="dim">%s &middot; %s</span></h1>\n' \
		"$(esc_html "$host")" "$(esc_html "$now")"
	printf '<p class="sub">%d changed, %s lines. ' "${#H_PATH[@]}" "$(esc_html "$total_lines")"
	printf 'Click any row to read its diff'
	# Said once here rather than left as a surprise at the bottom of a fold: with
	# this many checkouts the page shows the head of each diff, not all of it.
	if [ "$HTML_MAX_LINES" -lt 4000 ]; then
		printf ', shown to %d lines with this many changed' "$HTML_MAX_LINES"
	fi
	printf '.</p>\n'
	printf '<div class="bar"><button data-all="open">expand all</button>'
	printf '<button data-all="close">collapse all</button></div>\n'

	# The journal, in the scanner's own words: it formats these rows for the
	# terminal already, and rewording them here is how two views of one fleet start
	# telling a reader different things.
	if [ "$has_previous" = true ]; then
		printf '<h2>Since you last looked <span class="count">(%s)</span></h2>\n' \
			"$(esc_html "$previous_at")"
		printf '<div class="journal">\n'
		local any=0
		while IFS=$'\t' read -r verb name detail path; do
			[ -n "$verb" ] || continue
			any=1
			printf '<div><span class="verb %s">%s</span>' \
				"$(esc_html "$verb")" "$(esc_html "$verb")"
			if anchor=$(html_anchor "$path"); then
				printf '<a class="nm name" href="#%s">%s</a>' "$anchor" "$(html_name "$name")"
			else
				printf '<span class="nm name">%s</span>' "$(html_name "$name")"
			fi
			printf '<span class="detail">%s</span></div>\n' "$(esc_html "$detail")"
		done < <(jq -r 'select((.type == "repo"
				and (.activity == "new" or .activity == "updated")) or .type == "cleared")
			| [.activityVerb, (.name // .label), .activityDetail, .path] | @tsv' "$snapshot")
		[ "$any" -eq 1 ] || printf '<div class="none">Nothing has changed anywhere since then.</div>\n'
		printf '</div>\n'
	fi

	if [ ${#H_PATH[@]} -eq 0 ]; then
		printf '<h2>Nothing is changed anywhere</h2>\n'
		printf '<p class="none">Every checkout below the search roots is clean.</p>\n'
	else
		html_section mine 'Your checkouts'
		html_section agent 'Agent worktrees'
	fi

	printf '<footer>Every diff is measured from the merge base with the checkout&rsquo;s own '
	printf 'base branch, so it covers committed, staged, unstaged and new work - the same '
	printf 'range a pull request shows.<br>Made by <code>fleet-html</code> on %s. ' \
		"$(esc_html "$host")"
	printf 'Rerun it for a fresh one; nothing here updates on its own.</footer>\n'
	printf '<script>\n'
	html_script
	printf '</script>\n</body></html>\n'

	rm -f "$snapshot"
	return 0
}

# Where the page goes, and how it gets in front of a pair of eyes.
#
# A dev desk has no browser, so the useful thing to print there is not the path
# but the one command that renders it on the Mac: the report crosses the ssh
# connection that is already open, as a whole file, needing no forwarded port.
html_destination() {
	local dir=${GIT_FLEET_HTML_DIR:-$HOME/.cache/fleet}
	mkdir -p "$dir" 2>/dev/null || die "cannot create $dir"
	printf '%s/%s.html\n' "$dir" "${1:-$(hostname -s 2>/dev/null || printf 'fleet')}"
}

html_open() {
	local file=$1
	case $(uname -s) in
	Darwin)
		open -- "$file" >/dev/null 2>&1 && return 0
		;;
	*)
		if [ -n "${DISPLAY:-}" ] && have xdg-open; then
			xdg-open "$file" >/dev/null 2>&1 && return 0
		fi
		note "no browser here. From the Mac:  fleet-html --host $(hostname -f 2>/dev/null || hostname)"
		;;
	esac
	printf '%s\n' "$file"
	return 0
}

# Another machine's fleet, in this machine's browser. Just the report over ssh:
# it is one self-contained file, so there is nothing to serve and nothing to mount.
html_remote() {
	local host=$1 out=$2
	note "rendering $host's fleet over ssh"
	# shellcheck disable=SC2029 # deliberately expanded here; there are no arguments
	ssh -- "$host" 'fleet-html --stdout' >"$out" || {
		rm -f "$out"
		die "could not run fleet-html on $host - is the dotfiles checkout installed there?"
	}
	[ -s "$out" ] || {
		rm -f "$out"
		die "$host produced an empty report"
	}
	html_open "$out"
}

# ----------------------------------------------------------------- dispatch

one() {
	local repo top
	repo=${PATHS[0]}
	top=$(toplevel "$repo") || top=
	[ -n "$top" ] || die "not a git checkout: $repo"
	if [ ${#PATHS[@]} -eq 2 ]; then
		context "$top"
		file_body "$top" "${PATHS[1]}"
	else
		banner "$top"
		diff_body "$top"
	fi
}

html() {
	local out=$OUTPUT

	if [ "$out" = - ]; then
		[ -z "$HOST" ] || die '--host and --stdout ask for opposite things'
		html_report
		return 0
	fi

	[ -n "$out" ] || out=$(html_destination "${HOST:-}")

	if [ -n "$HOST" ]; then
		html_remote "$HOST" "$out"
		return 0
	fi

	# Written whole and then moved into place, so a page open in a browser is never
	# a half-written one after a reload.
	html_report >"$out.part" || {
		rm -f "$out.part"
		die 'the report failed'
	}
	mv -f "$out.part" "$out" || die "could not write $out"
	html_open "$out"
}

case $MODE in
print | show) one | render ;;
paths) stream "${PATHS[@]}" | render ;;
all) stream_all | render ;;
repos) repo_picker ;;
files) file_picker ;;
html) html ;;
esac
