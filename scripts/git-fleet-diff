#!/usr/bin/env bash
# Read what changed across every checkout and worktree on this machine.
#
# git-fleet-status answers "what changed anywhere". This answers the only
# question that ever follows it: show me. With no arguments it opens a picker of
# every changed *file* across every checkout, with that one file's diff beside
# it, and every key returns to the list, so reading a whole fleet is arrow keys
# and Enter and nothing else.
#
# One file is the unit on purpose. A worktree's whole diff can be thousands of
# lines, and a scroll-only preview pane is the wrong shape for it; a file is
# something the eye can take in, and typing filters across repository and
# filename at once, so "every .nix that changed anywhere" is four keystrokes.
# --repos keeps the coarser view for "what is this worktree doing overall".
#
# Agents work in detached-HEAD worktrees under a treehouse root, and neither
# obvious command works there: a bare `git diff` shows only the uncommitted tail
# of their work, and `git diff main` invents deletions for every commit the base
# branch gained meanwhile. So each diff is taken two-dot from the merge base with
# the checkout's own base branch - the comparison a pull request shows - which
# folds committed, staged and unstaged work into one stream, with whole new files
# appended.
#
# Read-only, like the scanner: nothing is staged and no index is written.
# Untracked files render through `git diff --no-index` rather than the usual
# `git add -N` trick, which would write to the index of a repository an agent is
# still working in.

set -uo pipefail

export GIT_OPTIONAL_LOCKS=0
export GIT_TERMINAL_PROMPT=0

PROG=${0##*/}
# Absolute, because fzf's preview and its key bindings run this script again by
# name from a shell whose PATH is not guaranteed to be this one.
SELF=$(cd -- "$(dirname -- "$0")" && pwd -P)/$(basename -- "$0")

note() {
	printf '%s: %s\n' "$PROG" "$1" >&2
}

die() {
	note "$1"
	exit 2
}

usage() {
	cat <<'EOF'
Usage: git-fleet-diff [options] [path...]

With no path, opens a picker of every changed file across every checkout and
worktree, with that file's diff alongside. Each diff is measured against the
checkout's own base branch, so it covers commits that branch has not seen plus
staged, unstaged and untracked work.

  enter             read this file's diff, full screen
  ctrl-r            the whole checkout's diff, full screen
  ctrl-g            open the checkout in lazygit
  ctrl-e            open the file in $EDITOR
  ctrl-d / ctrl-u   scroll the diff
  ctrl-/            cycle preview size
  esc               done

Every key comes back to the list, so nothing is a dead end.

Options:
  -R, --repos       pick a whole checkout instead of a file
  -a, --all         print every changed checkout's diff as one stream
  -s, --stat        summarise as changed files and counts, without contents
  -r, --root DIR    search root, repeatable; passed to git-fleet-status
  -d, --depth N     maximum search depth; passed to git-fleet-status
  -h, --help        this message

A path may be any directory inside a checkout. Rendering is delta's, configured
once in home/.config/git/pretty-diff.gitconfig, so this looks like every other
diff on the machine.
EOF
}

MODE=files
STAT=0
PAGE=1
SCAN_ARGS=()
PATHS=()

while [ $# -gt 0 ]; do
	case $1 in
	-R | --repos) MODE=repos ;;
	-a | --all) MODE=all ;;
	-s | --stat) STAT=1 ;;
	# --print renders into a preview pane, --show onto a real screen. Both take a
	# checkout and optionally one file inside it; they are how the picker calls
	# back into this script, and are equally usable by hand.
	-p | --print)
		MODE=print
		PAGE=0
		;;
	--show)
		MODE=show
		PAGE=1
		;;
	-r | --root | -d | --depth)
		flag=$1
		shift
		[ $# -gt 0 ] || die "$flag needs a value"
		SCAN_ARGS+=("$flag" "$1")
		;;
	-h | --help)
		usage
		exit 0
		;;
	-*) die "unknown option: $1" ;;
	*) PATHS+=("$1") ;;
	esac
	shift
done

case $MODE in
print | show)
	case ${#PATHS[@]} in
	1 | 2) ;;
	*) die "$MODE takes a checkout and optionally one file inside it" ;;
	esac
	;;
files)
	[ ${#PATHS[@]} -gt 0 ] && MODE=paths
	;;
esac

DELTA=$(command -v delta 2>/dev/null) || DELTA=
# delta wants the diff uncoloured so it can colour it itself; without delta,
# git's own colours through a pager are still perfectly readable.
if [ -n "$DELTA" ]; then
	DIFF_COLOR=--no-color
else
	DIFF_COLOR=--color=always
fi

DIFF_OPTS=("$DIFF_COLOR")
[ "$STAT" -eq 1 ] && DIFF_OPTS+=(--stat)

# ------------------------------------------------------------------ rendering

# Width drives two decisions, so it is measured once. Inside fzf the preview pane
# is narrower than the terminal and only fzf knows by how much.
term_width() {
	local w=${FZF_PREVIEW_COLUMNS:-}
	[ -n "$w" ] || w=$(tput cols 2>/dev/null) || w=
	case ${w:-} in
	'' | *[!0-9]*) printf '0\n' ;;
	*) printf '%s\n' "$w" ;;
	esac
}

render() {
	local width args=()
	width=$(term_width)

	if [ -z "$DELTA" ]; then
		if [ "$PAGE" -eq 1 ] && [ -t 1 ]; then less -R; else cat; fi
		return
	fi

	# Side-by-side only once there is room for two readable columns. Below that it
	# wraps every line into noise, and 80 columns is what an ssh window opens at.
	[ "$width" -ge 160 ] && args+=(--side-by-side)
	[ "$width" -gt 0 ] && args+=(--width "$width")
	if [ "$PAGE" -eq 0 ]; then
		# In a preview pane stdout is a pipe, which is normally delta's cue to drop
		# colour; fzf renders the ANSI itself, so force it.
		args+=(--paging=never)
		CLICOLOR_FORCE=1 "$DELTA" "${args[@]+"${args[@]}"}"
		return
	fi
	"$DELTA" "${args[@]+"${args[@]}"}"
}

# -------------------------------------------------------------- one checkout

# Best local base to measure a checkout's contribution against, without any
# network call. Mirrors git-fleet-status's own base_ref preference order so the
# scan's "unique commits" column and this diff describe the same range;
# tests/git-fleet-diff.test.sh asserts the two agree.
base_ref() {
	git -C "$1" for-each-ref --format='%(refname)' \
		refs/remotes/origin/HEAD refs/remotes/origin/main refs/remotes/origin/master \
		refs/heads/main refs/heads/master 2>/dev/null |
		awk '
    { seen[$0] = 1 }
    END {
      n = split("refs/remotes/origin/HEAD refs/remotes/origin/main " \
                "refs/remotes/origin/master refs/heads/main refs/heads/master", p, " ")
      for (i = 1; i <= n; i++) if (p[i] in seen) { print p[i]; exit }
    }
  '
}

# The single revision every tracked diff here is taken against. Fails, rather
# than defaulting, when there are no commits at all, because then there is no
# tracked side to show. A checkout with commits but no base branch to compare
# against still has an honest answer: its working tree against its own HEAD.
range_of() {
	local repo=$1 head base merge_base
	head=$(git -C "$repo" rev-parse -q --verify HEAD 2>/dev/null) || return 1
	[ -n "$head" ] || return 1
	base=$(base_ref "$repo")
	merge_base=
	[ -n "$base" ] &&
		{ merge_base=$(git -C "$repo" merge-base "$base" HEAD 2>/dev/null) || merge_base=; }
	printf '%s\n' "${merge_base:-HEAD}"
}

toplevel() {
	git -C "$1" rev-parse --show-toplevel 2>/dev/null
}

HOME_PHYS=$(cd -- "$HOME" 2>/dev/null && pwd -P) || HOME_PHYS=$HOME

# shellcheck disable=SC2088 # display text, never a path to expand
abbrev() {
	case $1 in
	"$HOME"/*) printf '~/%s\n' "${1#"$HOME"/}" ;;
	"$HOME_PHYS"/*) printf '~/%s\n' "${1#"$HOME_PHYS"/}" ;;
	*) printf '%s\n' "$1" ;;
	esac
}

# Whole new files, as new-file diffs, without touching the index.
#
# --no-index implies --exit-code, so every file it prints "fails" with status 1.
# Under pipefail that would make the whole stream look like an error, hence the
# explicit success: printing a diff is this function succeeding.
untracked_body() {
	local repo=$1 file
	while IFS= read -r -d '' file; do
		# A directory symlink or a file deleted since the scan makes this fail; that
		# is a stale entry, not something to report, so it is dropped.
		git -C "$repo" diff --no-index "${DIFF_OPTS[@]}" -- /dev/null "$file" 2>/dev/null
	done < <(git -C "$repo" ls-files -o --exclude-standard -z 2>/dev/null)
	return 0
}

diff_body() {
	local repo=$1 range
	range=$(range_of "$repo") && git -C "$repo" diff "${DIFF_OPTS[@]}" "$range" 2>/dev/null
	untracked_body "$repo"
}

# One file, from whichever side it lives on. The index decides: a path git knows
# about diffs against the range even when the working tree no longer has it,
# which is what shows a deletion; anything else is new and has no other side to
# compare against than nothing.
file_body() {
	local repo=$1 file=$2 range
	if git -C "$repo" ls-files --error-unmatch -- "$file" >/dev/null 2>&1; then
		range=$(range_of "$repo") &&
			git -C "$repo" diff "${DIFF_OPTS[@]}" "$range" -- "$file" 2>/dev/null
	else
		git -C "$repo" diff --no-index "${DIFF_OPTS[@]}" -- /dev/null "$file" 2>/dev/null
	fi
	return 0
}

branch_of() {
	local repo=$1 branch
	branch=$(git -C "$repo" symbolic-ref -q --short HEAD 2>/dev/null) ||
		branch="detached $(git -C "$repo" rev-parse -q --short HEAD 2>/dev/null)"
	printf '%s\n' "${branch:-no commits}"
}

# The stream concatenates many checkouts and delta has no idea where one ends, so
# each gets a banner. Box-drawing on purpose: a line starting with - or + inside
# a diff stream means something else.
banner() {
	printf '\n──────── %s  [%s]\n\n' "$(abbrev "$1")" "$(branch_of "$1")"
}

# Above a single file's diff, where the rule would be noise in a narrow pane. The
# picker row already carries the path; the branch is the part that says whose work
# this is, which is the whole question when seven worktrees hold the same file.
#
# No trailing blank line: delta opens its own output with one, and two of the
# thirty lines a preview pane has are too many to spend on nothing.
context() {
	printf '%s  [%s]\n' "$(abbrev "$1")" "$(branch_of "$1")"
}

# ------------------------------------------------------------------- scanning

resolve_scanner() {
	local candidate
	for candidate in \
		"${GIT_FLEET_STATUS:-}" \
		"$(command -v git-fleet-status 2>/dev/null)" \
		"$HOME/.dotfiles/scripts/git-fleet-status" \
		"$HOME/mac-setup/scripts/git-fleet-status"; do
		[ -n "$candidate" ] && [ -x "$candidate" ] && {
			printf '%s\n' "$candidate"
			return 0
		}
	done
	return 1
}

SCANNER=$(resolve_scanner) ||
	die 'git-fleet-status not found; set GIT_FLEET_STATUS or install the dotfiles'

require_jq() {
	command -v jq >/dev/null 2>&1 ||
		die 'jq is required; run scripts/install-diff-tools'
}

# path<TAB>row per changed checkout, reusing the row the scanner already rendered
# so the picker and the `fleet` table read identically rather than merely alike.
scan_rows() {
	require_jq
	"$SCANNER" --json "${SCAN_ARGS[@]+"${SCAN_ARGS[@]}"}" |
		jq -r 'select(.type == "repo") | [.path, .row] | @tsv'
}

scan_paths() {
	"$SCANNER" --paths "${SCAN_ARGS[@]+"${SCAN_ARGS[@]}"}"
}

stream() {
	local repo top
	for repo in "$@"; do
		top=$(toplevel "$repo") || top=
		[ -n "$top" ] || {
			note "not a git checkout: $repo"
			continue
		}
		banner "$top"
		diff_body "$top"
	done
}

stream_all() {
	local -a repos=()
	while IFS= read -r repo; do
		[ -n "$repo" ] && repos+=("$repo")
	done < <(scan_paths)
	[ ${#repos[@]} -gt 0 ] || {
		printf 'Nothing changed anywhere.\n'
		return 0
	}
	stream "${repos[@]}"
}

# ---------------------------------------------------------------- file rows

# checkout<TAB>file<TAB>status<TAB>label, one line per changed file anywhere.
#
# Renames arrive from --name-status as status, old, new; the new name is the one
# worth showing and the only one a later `git diff -- <path>` accepts. Untracked
# files are marked ? rather than A, because git has not been told about them and
# the distinction is the difference between reviewed and merely present.
file_rows() {
	local repo top label range status old new path
	while IFS= read -r repo; do
		[ -n "$repo" ] || continue
		top=$(toplevel "$repo") || continue
		[ -n "$top" ] || continue
		label=$(abbrev "$top")

		if range=$(range_of "$top"); then
			while IFS=$'\t' read -r status old new; do
				[ -n "${status:-}" ] || continue
				path=${new:-$old}
				printf '%s\t%s\t%s\t%s\n' "$top" "$path" "${status:0:1}" "$label"
			done < <(git -C "$top" diff --name-status "$range" 2>/dev/null)
		fi

		while IFS= read -r -d '' path; do
			# git reports a nested checkout as its directory, with a trailing slash.
			# Its contents belong to that repository, which the scan lists in its own
			# right when it is in scope, and there is no single file here to diff - so
			# the row would render an empty pane. Drop it rather than show a dead end.
			case $path in */) continue ;; esac
			printf '%s\t%s\t?\t%s\n' "$top" "$path" "$label"
		done < <(git -C "$top" ls-files -o --exclude-standard -z 2>/dev/null)
	done < <(scan_paths)
}

# status, checkout and file as three aligned columns, with the two hidden fields
# fzf needs kept in front. The checkout column is padded to the widest label so
# filenames line up down the page, capped so one deep worktree path cannot push
# every filename off screen; a capped label keeps its tail, which is the part
# that identifies it.
#
# Padding counts bytes, so the multi-byte ellipsis is paid for explicitly. Every
# other character in a path here is ASCII, where bytes and columns agree.
format_rows() {
	awk -F'\t' '
    { rows[NR] = $0; if (length($4) > width) width = length($4) }
    END {
      cap = 30
      if (width > cap) width = cap
      colour["M"] = "\033[33m"; colour["A"] = "\033[32m"; colour["?"] = "\033[32m"
      colour["D"] = "\033[31m"; colour["R"] = "\033[36m"; colour["C"] = "\033[36m"
      for (i = 1; i <= NR; i++) {
        n = split(rows[i], f, "\t")
        if (n < 4) continue
        label = f[4]
        pad = width
        if (length(label) > width) {
          label = "…" substr(label, length(label) - width + 2)
          pad = width + 2
        }
        c = (f[3] in colour) ? colour[f[3]] : ""
        printf "%s\t%s\t%s%s\033[0m  \033[2m%s\033[0m  %s\n", \
          f[1], f[2], c, f[3], sprintf("%-" pad "s", label), f[2]
      }
    }
  '
}

# --------------------------------------------------------------------- picker

have() {
	command -v "$1" >/dev/null 2>&1
}

# Actions are execute() bindings rather than --expect, so reading a diff returns
# to the list instead of ending the session. Browsing a fleet is the point; every
# key being a dead end was the thing that made it feel like work.
file_picker() {
	local rows binds=()

	if ! have fzf; then
		note 'fzf is not installed; showing every changed checkout instead'
		stream_all | render
		return
	fi

	# The column width comes from the widest label, so the rows are collected before
	# any of them can be shown. That is a few seconds across a whole fleet, and a
	# terminal that says nothing for a few seconds reads as a hang.
	note 'scanning every checkout…'
	rows=$(file_rows | format_rows)
	[ -n "$rows" ] || {
		printf 'Nothing changed anywhere.\n'
		return 0
	}

	binds+=("enter:execute($SELF --show {1} {2})")
	binds+=("ctrl-r:execute($SELF --show {1})")
	binds+=("ctrl-e:execute(cd -- {1} && ${EDITOR:-nvim} -- {2})")
	binds+=('ctrl-d:preview-half-page-down' 'ctrl-u:preview-half-page-up')
	binds+=('ctrl-/:change-preview-window(right,80%|down,75%|right,60%)')
	have lazygit && binds+=("ctrl-g:execute(lazygit --path {1})")

	printf '%s\n' "$rows" |
		fzf --ansi --layout=reverse --border --cycle --info=inline --scroll-off=3 \
			--delimiter=$'\t' --with-nth=3 \
			--preview="$SELF --print {1} {2}" \
			--preview-window='right,60%,border-left' \
			--header='enter read · ctrl-r whole repo · ctrl-g lazygit · ctrl-e edit · ctrl-d/u scroll' \
			"${binds[@]/#/--bind=}" >/dev/null
	return 0
}

repo_picker() {
	local rows binds=()

	if ! have fzf; then
		note 'fzf is not installed; showing every changed checkout instead'
		stream_all | render
		return
	fi

	rows=$(scan_rows) || return 1
	[ -n "$rows" ] || {
		printf 'Nothing changed anywhere.\n'
		return 0
	}

	binds+=("enter:execute($SELF --show {1})")
	binds+=("ctrl-e:execute(cd -- {1} && ${EDITOR:-nvim} .)")
	binds+=('ctrl-d:preview-half-page-down' 'ctrl-u:preview-half-page-up')
	binds+=('ctrl-/:change-preview-window(right,80%|down,75%|right,62%)')
	have lazygit && binds+=("ctrl-g:execute(lazygit --path {1})")

	printf '%s\n' "$rows" |
		fzf --ansi --no-sort --layout=reverse --border --cycle --info=inline \
			--delimiter=$'\t' --with-nth=2 \
			--preview="$SELF --print {1}" \
			--preview-window='right,62%,border-left' \
			--header='enter full diff · ctrl-g lazygit · ctrl-e editor · ctrl-d/u scroll' \
			"${binds[@]/#/--bind=}" >/dev/null
	return 0
}

# ----------------------------------------------------------------- dispatch

one() {
	local repo top
	repo=${PATHS[0]}
	top=$(toplevel "$repo") || top=
	[ -n "$top" ] || die "not a git checkout: $repo"
	if [ ${#PATHS[@]} -eq 2 ]; then
		context "$top"
		file_body "$top" "${PATHS[1]}"
	else
		banner "$top"
		diff_body "$top"
	fi
}

case $MODE in
print | show) one | render ;;
paths) stream "${PATHS[@]}" | render ;;
all) stream_all | render ;;
repos) repo_picker ;;
files) file_picker ;;
esac
