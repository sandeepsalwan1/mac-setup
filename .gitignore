# herdr runtime artifacts (regenerated at runtime; never commit). Herdr 0.8 added
# the last three, which showed up as untracked noise in every host's status.
home/.config/herdr/*.log
home/.config/herdr/session.json
home/.config/herdr/*.sock
home/.config/herdr/.plugins.lock
home/.config/herdr/release-notes.json
home/.config/herdr/sessions/
/home/.pi/agent/extensions/herdr-agent-state.ts

# macOS + nix build noise
.DS_Store
result
result-*

# Pi credentials and Home Manager adoption backups stay local
/home/.pi/agent/auth.json
/home/.pi/agent/**/*.backup

# Pi Calm is a runtime toggle; its local state file is never tracked
/home/.pi/agent/calm

# no-mistakes local validation state
.no-mistakes/

# Backpass local analysis state
.backpass/

# local implementation-plan deviation notes
decisions-??-??.md

# local environment and editor state
.direnv/
.env
.env.*

# Python bytecode from home/bin helpers
__pycache__/

# Workplace-specific material: present on the machine, deliberately never tracked,
# because this repository is public. Back these up somewhere private, not here.
# Paths whose names are themselves workplace-specific live in .git/info/exclude.
/home/AGENTS.local.md
/home/*.local.env
/home/*.local.txt
/scripts/link-local-extras

# Third-party book text kept locally as prompt reference material. It carries an
# "All rights reserved" notice, so it must not be published from here. Note that a
# GitHub web upload bypasses this file entirely; that is how it was published once.
/Clean code agent. .md
